@dataclass
class Node:
    label: str
    path: str = ""
    note: str = ""
    cmd: str = ""
    safety: str = SAFE
    kind: str = ""
    measured: int | None = None     # own du result, if this node maps to a path
    inner: int = 0                  # bytes already itemised by nested nodes
    size: int = 0                   # rolled-up display size
    children: list["Node"] = field(default_factory=list)
    expanded: bool = False
    stale: bool = False             # size came from cache, not this scan
    informational: bool = False     # a view onto bytes counted elsewhere
    blocked: bool = False           # the walk did not finish in the time it had
    partial: bool = False           # `measured` is a floor, not the whole figure
    detail: bool = False            # a breakdown of its parent, not a location
    before: int | None = None       # what the previous scan measured here
    depth: int = 0

    @property
    def is_leaf(self) -> bool:
        return not self.children


class Model:
    """The scan result, safe to read from the UI thread while the scan runs."""

    def __init__(self) -> None:
        self.lock = threading.Lock()
        self.categories: list[Node] = []
        self.total = 0
        self.count = 0
        self.done = 0
        self.pending = 0
        self.phase = "starting"
        self.finished = False
        self.started = time.time()
        self.elapsed = 0.0
        self.roots: list[str] = []
        self.disk = disk_usage()
        self.generation = 0          # bumps whenever the tree changes shape
        self.previous_at = 0.0       # when the scan we are comparing against ran
        self.vanished: list[tuple[str, int]] = []   # measured before, gone now

    # -- tree maintenance ---------------------------------------------------- #

    def recompute(self) -> None:
        """Subtract nested measurements, roll sizes up, sort by size."""
        measured = [n for n in self.walk()
                    if n.measured is not None and not n.informational]
        for n in measured:
            n.inner = 0
        stack: list[Node] = []
        # Order by path component, not by byte. Lexicographic order separates a
        # directory from its own descendants whenever a sibling's next character
        # sorts below os.sep -- ~/.cache-v2 falls between ~/.cache and
        # ~/.cache/uv -- and the stack below would then attribute the child to
        # nothing and count its bytes twice.
        for n in sorted(measured, key=lambda n: n.path.split(os.sep)):
            while stack and not n.path.startswith(stack[-1].path + os.sep):
                stack.pop()
            if stack:
                stack[-1].inner += n.measured or 0
            stack.append(n)

        def roll(node: Node) -> int:
            """Sets node.size for display; returns what it adds to its parent."""
            contributions = [roll(c) for c in node.children]
            if node.measured is not None:
                # `inner` took the itemised children out of this measurement so
                # nothing is counted twice; the children put themselves back.
                # Without the second half a location whose children itemise all
                # of it contributes nothing, and its category loses the lot.
                node.size = max(0, node.measured - node.inner) + sum(contributions)
            elif node.informational:
                node.size = sum(c.size for c in node.children)
            else:
                node.size = sum(contributions)
            if node.children:
                # informational rows last, so real bytes read first
                node.children.sort(
                    key=lambda c: (c.informational, -c.size, c.label.lower()))
            return 0 if node.informational else node.size

        for cat in self.categories:
            roll(cat)
        self.categories.sort(key=lambda c: (-c.size, c.label))
        self.total = sum(c.size for c in self.categories)
        self.count = sum(1 for n in self.walk() if self.is_location(n))

    def by_safety(self) -> dict[str, int]:
        """Mapped bytes split by how safe they are to remove.

        Locations only: a group is not measured and a breakdown is its parent
        said twice, so the three figures add up to `total` exactly."""
        split = {SAFE: 0, REBUILD: 0, REVIEW: 0}
        for node in self.walk():
            if self.is_location(node):
                split[node.safety] = split.get(node.safety, 0) + node.size
        return split

    @staticmethod
    def is_location(node: Node) -> bool:
        """A place on disk andy is reporting, rather than a breakdown of one.

        The individual rustup toolchains under `rustup toolchains` are the same
        bytes said twice; they belong in the tree, not in a count of locations
        or a list of the largest things found."""
        return (node.measured is not None and node.size > 0
                and not node.informational and not node.detail)

    def walk(self, nodes: list[Node] | None = None):
        for n in (self.categories if nodes is None else nodes):
            yield n
            if n.children:
                yield from self.walk(n.children)

    def category(self, name: str) -> Node:
        for c in self.categories:
            if c.label == name:
                return c
        node = Node(label=name)
        self.categories.append(node)
        return node


