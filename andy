@dataclass(frozen=True)
class Spec:
    cat: str
    label: str
    path: str
    note: str = ""
    cmd: str = ""
    safety: str = SAFE
    expand: str | None = None   # glob for itemised children
    namer: str | None = None    # "simulator" for device.plist lookup
    only: str | None = None     # the one platform this exists on


def S(cat, label, path, note="", cmd="", safety=SAFE, expand=None, namer=None,
      only=None) -> Spec:
    path = xdg_path(os.path.expanduser(path))
    if expand:
        expand = xdg_path(os.path.expanduser(expand))
    if only is None and "/Library/" in path:
        # Anything under ~/Library or /Library is Apple's layout. usable_dir
        # would filter these out on Linux anyway; tagging them means `--json`
        # can say what andy looked at rather than only what it found.
        only = "darwin"
    return Spec(cat, label, path, note, cmd, safety, expand, namer, only)


