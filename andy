class Ink:
    """Minimal ANSI styling that disappears when it should."""

    def __init__(self, enabled: bool) -> None:
        self.on = enabled

    def _w(self, code: str, text: str) -> str:
        return f"\033[{code}m{text}\033[0m" if self.on else text

    def dim(self, t): return self._w("2", t)
    def bold(self, t): return self._w("1", t)
    def head(self, t): return self._w("1;4", t)
    def accent(self, t): return self._w("36", t)
    def green(self, t): return self._w("32", t)
    def yellow(self, t): return self._w("33", t)
    def red(self, t): return self._w("31", t)

    def magnitude(self, n: int, text: str) -> str:
        if n >= 10 * 2 ** 30:
            return self.red(text)
        if n >= 2 ** 30:
            return self.yellow(text)
        if n >= 100 * 2 ** 20:
            return text
        return self.dim(text)

    def safety(self, s: str) -> str:
        return {SAFE: self.green, REBUILD: self.yellow, REVIEW: self.red}.get(s, self.dim)(s)


def term_width(default: int = 92) -> int:
    try:
        return max(60, min(shutil.get_terminal_size((default, 24)).columns, 120))
    except Exception:
        return default


def explain_nothing(m: Model, ink: Ink, p) -> None:
    """Why there is nothing to show, which is four different situations.

    "nothing found" covered all of them: a clean machine, roots that hold
    nothing, a typo in a directory name, and a scan that failed. Three of those
    have something useful to say and the first is good news, so saying which
    one it was is most of the value here.
    """
    if m.phase.startswith("scan error"):
        p(f"  {ink.red('the scan did not finish')}  {ink.dim(m.phase)}")
        p(f"  {ink.dim('so this is not a report that nothing is there')}")
        return

    if m.roots:
        p(f"  {ink.dim('nothing found')}")
        p()
        known = (f"andy knows {len(CATALOG)} places developer tools keep "
                 f"things, and none of them exist here.")
        p(f"  {ink.dim(known)}")
        p(f"  {ink.dim('It also looked for build output under:')}")
        for root in m.roots:
            p(f"    {ink.dim(tilde(root))}")
        advice = ("If that is not where your code lives, name the directory: "
                  "andy ~/src")
        p(f"  {ink.dim(advice)}")
        return

    p(f"  {ink.dim('nothing found, and no project directories to look in')}")
    p()
    usual = "andy looks in ~/Code, ~/Projects, ~/dev and the other usual names."
    p(f"  {ink.dim(usual)}")
    p(f"  {ink.dim('None of them exist here, so name yours: andy ~/src')}")


def print_report(m: Model, ink: Ink, top: int, out=sys.stdout) -> None:
    w = term_width()
    total, used, free = m.disk
    pct = used / total if total else 0.0

    p = lambda s="": print(s, file=out)
    p()
    tight = ink.red if free < 15 * 2 ** 30 else ink.green
    p(f" {ink.bold('andy')}  "
      f"{ink.dim(f'{human(total)} volume {DOT} {human(used)} used {DOT} ')}"
      f"{tight(human(free) + ' free')}  {bar(pct, 18)} {pct * 100:.0f}%")
    p()

    if not m.categories or not m.total:
        explain_nothing(m, ink, p)
        return

    biggest = max((c.size for c in m.categories), default=1) or 1
    labelw = max(len(c.label) for c in m.categories) + 2
    barw = max(12, min(28, w - labelw - 22))
    for c in m.categories:
        if c.size <= 0:
            continue
        leaves = sum(1 for n in m.walk([c]) if m.is_location(n))
        p(f"  {c.label.ljust(labelw)}{ink.magnitude(c.size, human(c.size, pad=True))}  "
          f"{ink.accent(bar(c.size / biggest, barw))} {ink.dim(str(leaves))}")
    p(f"  {'':{labelw}}{ink.dim(RULE * 5)}")
    share = f"{m.total / used * 100:.0f}% of used space" if used else ""
    p(f"  {ink.bold('total'.ljust(labelw))}{ink.bold(human(m.total, pad=True))}  {ink.dim(share)}")

    split = m.by_safety()
    if m.total:
        p()
        p(f"  {ink.dim('of which')}  "
          f"{ink.green(human(split[SAFE]))} {ink.dim('regenerates itself')}   "
          f"{ink.yellow(human(split[REBUILD]))} {ink.dim('costs you a rebuild')}   "
          f"{ink.red(human(split[REVIEW]))} {ink.dim('wants a look first')}")

    if top:
        items = sorted((n for n in m.walk() if m.is_location(n)),
                       key=lambda n: -n.size)[:top]
        p()
        p(f" {ink.head('largest items')}")
        p()
        namew = max((len(n.label) for n in items), default=10)
        namew = min(namew, max(18, w // 3))
        for n in items:
            room = w - namew - 22
            p(f"  {ink.magnitude(n.size, human(n.size, pad=True))}  "
              f"{ink.safety(MARK.get(n.safety, '?'))}  "
              f"{short_path(n.label, namew).ljust(namew)}  "
              f"{ink.dim(short_path(n.path, room))}")
        p()
        legend = (f"{ink.green('s')} regenerates itself   "
                  f"{ink.yellow('r')} costs a rebuild   "
                  f"{ink.red('!')} wants a look first")
        p(f"  {ink.dim(legend)}")

    blocked = [n for n in m.walk() if n.blocked]
    if blocked:
        p()
        p(f" {ink.yellow('still counting when time ran out')}  "
          f"{ink.dim(str(len(blocked)) + (' location' if len(blocked) == 1 else ' locations'))}")
        for n in blocked[:4]:
            if n.partial:
                known = f" (at least {human(n.size)} so far)"
            elif n.measured:
                known = f" (last scan: {human(n.size)})"
            else:
                known = " (nothing counted)"
            p(f"   {ink.dim(DOT)} {n.label}{ink.dim(known)}")
        # Built outside the f-string: an expression may not span lines inside one
        # until Python 3.12, and andy supports 3.9.
        why = ("these are floors, not totals. A running container VM or a network "
               "mount blocks on I/O for minutes; stop it, or point andy at that "
               "path alone")
        p(f"   {ink.dim(why)}")

    p()
    p(f" {ink.dim('andy -i')} to browse   "
      f"{ink.dim('andy --commands')} to print reclaim commands   "
      f"{ink.dim('andy --tree')} for everything")
    p()


def print_delta(m: Model, ink: Ink, top: int, out=sys.stdout) -> None:
    """What changed since the previous scan.

    andy is otherwise entirely about now. This is the one place it is about
    time, so the interval it is comparing across is stated rather than implied:
    the cache is whenever andy last ran, which might be ten minutes or three
    weeks, and a number without that context would be worse than no number."""
    w = term_width()
    p = lambda s="": print(s, file=out)
    p()

    if not m.previous_at:
        p(f" {ink.bold('andy')}  {ink.dim('nothing to compare against yet')}")
        p()
        p("  This is the first scan andy has cached, so there is no previous")
        p("  figure to subtract. Run it again later and this will have an answer.")
        p()
        return

    when = ago(time.time() - m.previous_at)
    p(f" {ink.bold('andy')}  {ink.dim('change since the previous scan, ' + when)}")
    p()

    grew = [n for n in m.walk() if m.is_location(n) and n.before is not None
            and n.size != n.before]
    fresh = [n for n in m.walk() if m.is_location(n) and n.before is None]
    grew.sort(key=lambda n: -abs(n.size - n.before))
    fresh.sort(key=lambda n: -n.size)

    if not grew and not fresh and not m.vanished:
        p(f"  {ink.dim('nothing has changed size since then')}")
        p()
        return

    # Three totals, not one. A location with no previous figure may be newly
    # created or merely newly recognised -- a catalog entry added since the last
    # release makes bytes that were always there look like growth -- so it is
    # counted apart from the change andy can actually vouch for.
    changed = sum(n.size - n.before for n in grew)
    added = sum(n.size for n in fresh)
    removed = sum(size for _, size in m.vanished)

    namew = min(max((len(n.label) for n in grew + fresh), default=10),
                max(18, w // 3))
    limit = top or len(grew)

    def heading(word, note):
        p(f" {ink.head(word)}  {ink.dim(note)}")
        p()

    if grew:
        heading("changed", f"{len(grew)} location{'s' if len(grew) != 1 else ''}")
        for n in grew[:limit]:
            change = n.size - n.before
            paint = ink.red if change > 0 else ink.green
            p(f"  {paint(signed(change).rjust(7))}  "
              f"{short_path(n.label, namew).ljust(namew)}  "
              f"{ink.dim(human(n.before) + ' ' + RIGHT + ' ' + human(n.size))}")
        if len(grew) > limit:
            p(f"  {ink.dim(f'... and {len(grew) - limit} more')}")
        p()

    if fresh:
        heading("new", f"{human(added)} in {len(fresh)} location"
                       f"{'s' if len(fresh) != 1 else ''} andy had not measured "
                       f"before, which may mean created or merely recognised")
        for n in fresh[:limit]:
            p(f"  {ink.magnitude(n.size, human(n.size, pad=True))}  "
              f"{short_path(n.label, namew).ljust(namew)}  "
              f"{ink.dim(short_path(n.path, max(10, w - namew - 14)))}")
        if len(fresh) > limit:
            p(f"  {ink.dim(f'... and {len(fresh) - limit} more')}")
        p()

    if m.vanished:
        heading("gone", f"{human(removed)} in {len(m.vanished)} location"
                        f"{'s' if len(m.vanished) != 1 else ''} measured before "
                        f"and not there now")
        for path, size in m.vanished[:limit]:
            p(f"  {ink.green(('-' + human(size)).rjust(7))}  "
              f"{ink.dim(short_path(path, w - 12))}")
        if len(m.vanished) > limit:
            p(f"  {ink.dim(f'... and {len(m.vanished) - limit} more')}")
        p()

    paint = ink.red if changed > 0 else ink.green
    p(f"  {ink.bold('net')}  {paint(signed(changed))}  "
      f"{ink.dim(f'across the {len(grew)} location' + ('s' if len(grew) != 1 else '') + ' andy could compare')}")
    p()


def print_tree(m: Model, ink: Ink, min_bytes: int, out=sys.stdout) -> None:
    w = term_width()
    p = lambda s="": print(s, file=out)
    p()
    if not any(c.size >= min_bytes for c in m.categories):
        # An empty tree means one of two quite different things, and the floor
        # is the likelier one: the default hides everything under 10M.
        locations = [n for n in m.walk() if m.is_location(n)]
        if locations:
            biggest = max(n.size for n in locations)
            count = f"{len(locations)} location{'s' if len(locations) != 1 else ''}"
            p(f"  {ink.dim(f'{count} found, none of them over {human(min_bytes)}')}")
            hint = f"the largest is {human(biggest)}; try -m 0 to see everything"
            p(f"  {ink.dim(hint)}")
        else:
            explain_nothing(m, ink, p)
        p()
        return
    for c in m.categories:
        if c.size < min_bytes:
            continue
        p(f" {ink.head(c.label)}  {ink.bold(human(c.size))}")

        def emit(node: Node, depth: int) -> None:
            for child in node.children:
                if child.size < min_bytes and not child.informational:
                    continue        # too small to show, and so is everything in it
                pad = "  " + "  " * depth
                label = short_path(child.label, max(20, w - len(pad) - 30))
                p(f"{pad}{ink.magnitude(child.size, human(child.size, pad=True))}  {label}")
                emit(child, depth + 1)

        emit(c, 1)
        p()


# What a placeholder stands for. The directory ones andy knows exactly; the
# name ones are the basename of an itemised child, which is why 0016 mattered
# here -- before it there were no children to name.
CMD_DIR = ("<project>", "<repo>")
CMD_NAME = ("<version>", "<name>", "<profile>", "<vm>", "<model>", "<id>", "<pkg>")


def fill_command(cmd: str, node: Node, roots: list[str]) -> str:
    """Put real values into a reclaim command, where andy has them.

    Absolute and shell-quoted rather than tilde-shortened: this is meant to be
    read and then pasted, and a path with a space in it that splits into two
    arguments halfway through an `rm -rf` is the one mistake this program must
    never help anybody make. A placeholder andy cannot fill is left standing,
    so it still reads as something to supply.
    """
    if not cmd or "<" not in cmd or not node.path:
        return cmd
    quoted = shlex.quote(node.path)
    cmd = cmd.replace("<path>", quoted)
    for token in CMD_DIR:
        cmd = cmd.replace(token, shlex.quote(os.path.dirname(node.path)))
    if "<root>" in cmd:
        root = next((r for r in roots if node.path.startswith(r + os.sep)),
                    os.path.dirname(node.path))
        cmd = cmd.replace("<root>", shlex.quote(root))
    for token in CMD_NAME:
        cmd = cmd.replace(token, shlex.quote(os.path.basename(node.path)))
    return cmd


def reclaim_rows(m: Model, min_bytes: int) -> list[tuple[Node, Node, str]]:
    """(category, location, command) for everything worth offering."""
    rows: list[tuple[Node, Node, str]] = []
    for category in m.categories:
        for node in m.walk([category]):
            if not node.cmd or node.size < min_bytes:
                continue
            details = [c for c in node.children if c.detail and c.size >= min_bytes]
            if details and any(token in node.cmd for token in CMD_NAME):
                # the command wants a name and the children are the names
                for child in sorted(details, key=lambda c: -c.size):
                    rows.append((category, child, fill_command(node.cmd, child, m.roots)))
            elif m.is_location(node):
                rows.append((category, node, fill_command(node.cmd, node, m.roots)))
    return rows


def selected_rows(m: Model, nodes: list[Node],
                  min_bytes: int = 0) -> list[tuple[Node, Node, str]]:
    """Reclaim rows limited to `nodes` and everything underneath them.

    Marking a group has to mean its members: `node_modules` is not a place on
    disk, and a script line saying so would be the placeholder problem again.
    """
    wanted: set[int] = set()
    for node in nodes:
        for inside in m.walk([node]):
            wanted.add(id(inside))
    return [row for row in reclaim_rows(m, min_bytes) if id(row[1]) in wanted]


def write_commands(m: Model, rows: list[tuple[Node, Node, str]], ink: Ink, p,
                   headline: str) -> None:
    """The script itself, shared by --commands and the browser's copy."""
    total = sum(n.size for _, n, _ in rows)
    p("#!/bin/sh")
    p("# Reclaim commands suggested by andy. NOTHING here has been run.")
    p("# Read every line before you run it; some are destructive by design.")
    p(f"# generated {time.strftime('%Y-%m-%d %H:%M')}  {DOT}  {human(m.total)} mapped")
    if not rows:
        p(f"# {headline}")
        return
    p(f"# this would reclaim about {human(total)}, "
      f"in {len(rows)} place{'s' if len(rows) != 1 else ''}")

    for category in m.categories:
        here = [(n, cmd) for c, n, cmd in rows if c is category]
        if not here:
            continue
        size = sum(n.size for n, _ in here)
        title = f"{category.label}  {human(size)}"
        p()
        p(f"# ---- {title} " + "-" * max(0, 62 - len(title)))
        # Grouped by explanation, groups ordered by their largest member.
        # Thirteen cargo targets share one note; printing it thirteen times
        # buries the thirteen paths that are the point of the section.
        seen: set[str] = set()
        groups: dict[str, list[tuple[Node, str]]] = {}
        for node, cmd in sorted(here, key=lambda pair: -pair[0].size):
            if cmd in seen:
                continue                # one global command, said once
            seen.add(cmd)
            groups.setdefault(node.note, []).append((node, cmd))
        for note, members in sorted(groups.items(),
                                    key=lambda kv: -kv[1][0][0].size):
            if note:
                p(f"\n#   {note}")
            for node, cmd in members:
                p(f"\n# {node.label}  ({human(node.size)}, {node.safety})")
                p(f"# {cmd}")


def print_commands(m: Model, ink: Ink, min_bytes: int, out=sys.stdout) -> None:
    """Emit the reclaim commands as a commented script. Never runs anything."""
    write_commands(m, reclaim_rows(m, min_bytes), ink,
                   lambda s="": print(s, file=out),
                   "nothing here is over the size floor; try -m 0")


def script_for(m: Model, nodes: list[Node]) -> str:
    """The same script, for the clipboard."""
    out = io.StringIO()
    write_commands(m, selected_rows(m, nodes), Ink(False),
                   lambda s="": print(s, file=out), "nothing here to reclaim")
    return out.getvalue()


def to_json(m: Model) -> dict:
    def node(n: Node) -> dict:
        d = {"label": n.label, "bytes": n.size}
        if n.informational:
            d["informational"] = True
        if n.detail:
            d["detail"] = True
        if n.blocked:
            # `bytes` is a floor rather than a total: the walk did not finish
            d["complete"] = False
            d["measured"] = bool(n.partial)
        if n.path:
            d["path"] = n.path
        if n.before is not None:
            d["previous_bytes"] = n.before
            d["change_bytes"] = n.size - n.before
        if n.kind:
            d["kind"] = n.kind
        if n.cmd:
            d["reclaim"] = n.cmd
            d["safety"] = n.safety
        if n.children:
            d["children"] = [node(c) for c in n.children]
        return d

    total, used, free = m.disk
    looked_at = sum(1 for s in CATALOG) + len(m.roots)
    return {
        "version": VERSION,
        "platform": PLATFORM,
        "locations_known": looked_at,
        "scanned_at": time.strftime("%Y-%m-%dT%H:%M:%S"),
        "duration_seconds": round(m.elapsed, 2),
        "volume": {"total_bytes": total, "used_bytes": used, "free_bytes": free},
        "mapped_bytes": m.total,
        "reclaimable_bytes": {name: value for name, value in m.by_safety().items()},
        "roots": m.roots,
        "previous_scan_at": (time.strftime("%Y-%m-%dT%H:%M:%S",
                                           time.localtime(m.previous_at))
                             if m.previous_at else None),
        "vanished": [{"path": p, "previous_bytes": size} for p, size in m.vanished],
        "categories": [node(c) for c in m.categories],
    }


