def dedupe_dirs(paths: list[str]) -> list[str]:
    """Drop repeats and nested entries. Identity comes from the inode, because
    ~/Code and ~/code are one directory on a case-insensitive volume."""
    roots: list[str] = []
    seen: set[tuple[int, int]] = set()
    for path in paths:
        p = os.path.realpath(path)
        if not usable_dir(p):
            continue
        try:
            st = os.stat(p)
        except OSError:
            continue
        key = (st.st_dev, st.st_ino)
        if key in seen:
            continue
        if any(p.lower().startswith(r.lower() + os.sep) for r in roots):
            continue
        seen.add(key)
        roots.append(p)
    return roots


def default_roots() -> list[str]:
    return dedupe_dirs([os.path.expanduser(c) for c in ROOT_CANDIDATES])


def has_marker(directory: str) -> bool:
    try:
        names = set(os.listdir(directory))
    except OSError:
        return False
    if names & set(MARKERS):
        return True
    return any(n.endswith((".csproj", ".xcodeproj", ".sln", ".vcxproj")) for n in names)


def find_artifacts(roots: list[str], depth: int = 9) -> list[tuple[str, str]]:
    """Locate project build artifacts and .git dirs. Returns (path, kind) pairs."""
    if not roots:
        return []
    pruned = sorted(set(ARTIFACTS_STRICT) | AMBIGUOUS_PRUNE | {".git"})
    walked = sorted(set(ARTIFACTS_AMBIGUOUS) - AMBIGUOUS_PRUNE)

    def names(group):
        out = []
        for i, n in enumerate(group):
            if i:
                out.append("-o")
            out += ["-name", n]
        return out

    cmd = ["find", *roots, "-maxdepth", str(depth), "-type", "d", "("]
    cmd += ["("] + names(pruned) + [")", "-prune", "-print0"]
    if walked:
        cmd += ["-o", "("] + names(walked) + [")", "-print0"]
    cmd += [")"]
    try:
        p = subprocess.run(cmd, capture_output=True, timeout=900)
    except Exception:
        return []

    found: list[tuple[str, str]] = []
    for raw in p.stdout.split(b"\0"):
        if not raw:
            continue
        path = os.fsdecode(raw)
        base = os.path.basename(path)
        if os.path.islink(path):
            continue
        if base == ".git":
            found.append((path, ".git"))
        elif base in ARTIFACTS_STRICT:
            found.append((path, ARTIFACTS_STRICT[base]))
        elif base in ARTIFACTS_AMBIGUOUS and has_marker(os.path.dirname(path)):
            found.append((path, ARTIFACTS_AMBIGUOUS[base]))
    return found


def docker_breakdown() -> list[tuple[str, int, str, str, str]]:
    """Live docker disk usage, when a daemon is reachable."""
    try:
        p = subprocess.run(
            ["docker", "system", "df", "--format", "{{json .}}"],
            capture_output=True, text=True, timeout=12,
        )
    except Exception:
        return []
    if p.returncode != 0:
        return []
    cmds = {
        "Images": ("images", "docker image prune -a", REBUILD),
        "Containers": ("containers", "docker container prune", REVIEW),
        "Local Volumes": ("volumes", "docker volume prune", REVIEW),
        "Build Cache": ("build cache", "docker builder prune -a", SAFE),
    }
    rows = []
    for line in p.stdout.splitlines():
        try:
            d = json.loads(line)
        except ValueError:
            continue
        kind = d.get("Type", "")
        label, cmd, safety = cmds.get(kind, (kind.lower(), "", REVIEW))
        size = parse_docker_size(d.get("Size", "0"))
        total = d.get("TotalCount") or d.get("Total") or "?"
        active = d.get("Active", "")
        recl = (d.get("Reclaimable") or "").strip()
        note = f"{total} total"
        if active not in ("", "0", 0):
            note += f", {active} in use"
        if recl:
            note += f" {DOT} {recl} reclaimable"
        rows.append((label, size, cmd, safety, note))
    return rows


def parse_docker_size(text: str) -> int:
    text = text.strip()
    units = {"B": 1, "KB": 10 ** 3, "MB": 10 ** 6, "GB": 10 ** 9, "TB": 10 ** 12,
             "KIB": 2 ** 10, "MIB": 2 ** 20, "GIB": 2 ** 30, "TIB": 2 ** 40}
    num, unit = "", ""
    for ch in text:
        if ch.isdigit() or ch == ".":
            num += ch
        elif not ch.isspace():
            unit += ch
    try:
        return int(float(num) * units.get(unit.upper(), 1))
    except ValueError:
        return 0


