def encodable(text: str, stream) -> bool:
    """Whether this stream can actually put `text` on the screen."""
    encoding = getattr(stream, "encoding", None) or "ascii"
    try:
        text.encode(encoding)
    except (UnicodeEncodeError, LookupError):
        return False
    return True


# Python normally coerces a C locale to C.UTF-8 (PEP 538) and andy's drawing
# characters survive. With that coercion off -- PYTHONCOERCECLOCALE=0, which
# some containers set -- or in a genuinely 8-bit locale, encoding them raises
# and the report dies on its first line. So the glyphs are chosen from what the
# stream can carry, and there is an ASCII set for when it can carry nothing.
UNICODE = encodable("\u2588\u258f\u00b7\u2500\u2026\u2265\u25b8\u25be\u280b", sys.stdout)

if UNICODE:
    FULL_CELL = "\u2588"
    PARTIAL_CELLS = "\u258f\u258e\u258d\u258c\u258b\u258a\u2589"
    DOT, RULE, ELLIPSIS, ATLEAST = "\u00b7", "\u2500", "\u2026", "\u2265"
    CLOSED, OPENED, SCROLLBAR = "\u25b8", "\u25be", "\u258c"
    ENTER = "\u21b5"
    DASH = "\u2014"
    CRUMB = "\u203a"
    UP, DOWN, LEFT, RIGHT = "\u2191", "\u2193", "\u2190", "\u2192"
    SPINNER = "\u280b\u2819\u2839\u2838\u283c\u2834\u2826\u2827\u2807\u280f"
else:
    FULL_CELL = "#"
    PARTIAL_CELLS = " " * 7          # ASCII has no eighth-cells to draw with
    DOT, RULE, ELLIPSIS, ATLEAST = "*", "-", "...", ">="
    CLOSED, OPENED, SCROLLBAR = ">", "v", "|"
    ENTER = "enter"
    DASH = "--"
    CRUMB = ">"
    UP, DOWN, LEFT, RIGHT = "up", "down", "left", "right"
    SPINNER = "|/-\\"

# stdout may still meet something neither branch anticipated -- an 8-bit
# encoding that carries some of this and not the rest. Replacing is ugly and
# never fatal, which is the right trade for a read-only report.
try:
    sys.stdout.reconfigure(errors="replace")
    sys.stderr.reconfigure(errors="replace")
except Exception:                                       # pragma: no cover
    pass


def human(n: int, pad: bool = False) -> str:
    """Bytes as a short human string: 4.7G, 812M, 3.1K."""
    if n <= 0:
        return "    -" if pad else "-"
    for unit, step in (("T", 2 ** 40), ("G", 2 ** 30), ("M", 2 ** 20), ("K", 2 ** 10)):
        if n >= step:
            v = n / step
            s = f"{v:.0f}{unit}" if v >= 100 else f"{v:.1f}{unit}"
            break
    else:
        s = f"{n}B"
    return s.rjust(5) if pad else s


def signed(n: int) -> str:
    """A change, with its direction: +2.1G, -840M, or a dash for none."""
    if n == 0:
        return "-"
    return ("+" if n > 0 else "-") + human(abs(n))


def ago(seconds: float) -> str:
    """How long ago, in the roughest unit that still says something."""
    if seconds < 0:
        return "the future"          # a clock moved; say so rather than lie
    for unit, size in (("day", 86400), ("hour", 3600), ("minute", 60)):
        count = int(seconds // size)
        if count:
            return f"{count} {unit}{'s' if count != 1 else ''} ago"
    return "moments ago"


def tilde(path: str) -> str:
    if path == HOME:
        return "~"
    return "~" + path[len(HOME):] if path.startswith(HOME + os.sep) else path


def clip_end(text: str, width: int) -> str:
    """Trim from the right. For a narrow treemap cell the leading words are the
    identifying ones, so middle-elision would throw away the wrong half."""
    if width <= 0:
        return ""
    if len(text) <= width:
        return text
    if width <= len(ELLIPSIS):
        return text[:width]
    return text[:width - len(ELLIPSIS)] + ELLIPSIS


def shorten(text: str, width: int) -> str:
    """Trim to width, eliding the middle of long paths."""
    if width <= 0:
        return ""
    if len(text) <= width:
        return text
    keep = width - len(ELLIPSIS)
    if keep <= 1:
        return text[:width]
    head = keep // 3
    return text[:head] + ELLIPSIS + text[len(text) - (keep - head):]


def short_path(text: str, width: int) -> str:
    """Trim a path by dropping whole directories out of the middle.

    shorten() cuts by character, which on a path throws away the segments that
    identify it and keeps a prefix shared with everything else on screen --
    eight rustup toolchains all rendering as `~/.rustup...rch64-apple-darwin`.
    The last two segments name the thing, so they are what survives.
    """
    text = tilde(text)
    if width <= 0:
        return ""
    if len(text) <= width:
        return text
    parts = text.split(os.sep)
    if len(parts) > 2:
        lead = parts[0]
        # Keep as many trailing segments as will fit, and the leading one too
        # when there is room for it. Tail before head: `.../0030-multi-cursor/
        # target` says which worktree, `.worktrees/.../target` does not.
        for keep in range(len(parts) - 1, 0, -1):
            tail = parts[-keep:]
            for candidate in (os.sep.join([lead, ELLIPSIS] + tail),
                              os.sep.join([ELLIPSIS] + tail)):
                if len(candidate) <= width:
                    return candidate
    # a single segment longer than the space: keep its end, which is the part
    # that differs, rather than its beginning, which is the part that does not
    if width <= len(ELLIPSIS):
        return text[-width:]
    return ELLIPSIS + text[-(width - len(ELLIPSIS)):]


def bar(fraction: float, width: int) -> str:
    """A horizontal bar with one-eighth-cell precision."""
    if width <= 0:
        return ""
    fraction = max(0.0, min(1.0, fraction))
    eighths = int(round(fraction * width * 8))
    full, rem = divmod(eighths, 8)
    full = min(full, width)
    out = FULL_CELL * full
    if rem and full < width:
        out += PARTIAL_CELLS[rem - 1]
    return out.ljust(width)


# Whoever answers first. Wayland before X11, because a Wayland session usually
# still has xclip installed and pointing at a display nothing is reading.
CLIPBOARDS = ((["pbcopy"],) if MACOS else
              (["wl-copy"], ["xclip", "-selection", "clipboard"],
               ["xsel", "--clipboard", "--input"]))


def clip(text: str) -> bool:
    """Put text on the clipboard. Read-only with respect to the filesystem."""
    for argv in CLIPBOARDS:
        if not shutil.which(argv[0]):
            continue
        try:
            p = subprocess.run(argv, input=text, text=True, timeout=5,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if p.returncode == 0:
                return True
        except Exception:
            continue
    return False


def usable_dir(path: str) -> bool:
    return os.path.isdir(path) and not os.path.islink(path)


def disk_usage(path: str = HOME) -> tuple[int, int, int]:
    """Volume totals for `path`, falling back when it cannot be read.

    HOME is not guaranteed to exist. A container running as a uid with no passwd
    entry, a systemd unit with HOME unset, `su` without `-` -- all of them hand a
    program a home that was never created, and dying on the first statvfs is a
    poor way to report it. Which volume the header describes is a detail; the
    scan is the point."""
    for candidate in (path, os.getcwd(), os.sep):
        try:
            total, used, free = shutil.disk_usage(candidate)
            return total, used, free
        except OSError:
            continue
    return 0, 0, 0


# --------------------------------------------------------------------------- #
# measurement
# --------------------------------------------------------------------------- #
#
# Everything below runs on daemon threads, and concurrent.futures is deliberately
# not used anywhere in this program. Its workers are not daemons and it installs
# an atexit hook that joins them, so one call wedged on filesystem I/O -- which
# is exactly what a running container VM does to anything that reads its data
# directory -- would keep andy from exiting. A daemon thread in the same state is
# simply abandoned, and quitting stays instant. That is the whole reason for the
# two small classes here rather than four lines of stdlib.

MEASURE_BUDGET = 180.0   # seconds one measurement phase may take, in total
MEASURE_TICK = 0.12      # how often climbing figures are published to the model


class Task:
    """A function on a daemon thread, with a result you can wait for."""

    def __init__(self, fn, *args) -> None:
        self._value = None
        self._done = threading.Event()
        threading.Thread(target=self._run, args=(fn, args), daemon=True).start()

    def _run(self, fn, args) -> None:
        try:
            self._value = fn(*args)
        except Exception:
            self._value = None
        finally:
            self._done.set()

    def result(self, timeout: float | None = None, default=None):
        """What the call returned, or `default` if it raised or is still going."""
        if not self._done.wait(timeout) or self._value is None:
            return default
        return self._value


class Walk:
    """One directory being measured, and the total counted for it so far."""

    __slots__ = ("root", "dev", "total", "pending", "seen", "lock")

    def __init__(self, root: str) -> None:
        self.root = root
        self.dev: int | None = None
        self.total = 0
        self.pending = 1            # units of work outstanding; 0 means finished
        self.seen: set[int] = set()  # inodes of multiply-linked files, counted once
        self.lock = threading.Lock()

    def state(self) -> tuple[int, bool]:
        with self.lock:
            return self.total, self.pending <= 0


def scan_dir(walk: Walk, path: str, stopped=lambda: False) -> tuple[int, list[str]]:
    """One directory, du's way: its entries' allocated blocks and its subdirectories.

    Shared by the Walker, which spreads directories across threads, and by
    DuMeasurer's fallback, which walks a single tree in order when du's output
    cannot be trusted. Keeping one copy is what keeps the two engines agreeing
    to the byte.
    """
    total = 0
    subdirs: list[str] = []
    try:
        with os.scandir(path) as entries:
            for entry in entries:
                if stopped():
                    break
                try:
                    st = entry.stat(follow_symlinks=False)
                except OSError:
                    continue                      # vanished mid-walk
                if st.st_dev != walk.dev:
                    continue                      # du -x: one filesystem only
                is_dir = st.st_mode & 0o170000 == stat.S_IFDIR
                if not is_dir and st.st_nlink > 1:
                    with walk.lock:
                        if st.st_ino in walk.seen:
                            continue              # already counted under another name
                        walk.seen.add(st.st_ino)
                total += st.st_blocks * 512
                if is_dir:
                    subdirs.append(entry.path)
    except OSError:
        pass                                      # unreadable: du counts nothing either
    return total, subdirs


def walk_tree(walk: Walk, stopped=lambda: False) -> int:
    """Measure one tree in this process, start to finish, and return the total."""
    try:
        st = os.lstat(walk.root)
    except OSError:
        return 0
    walk.dev = st.st_dev
    total = st.st_blocks * 512
    pending = [walk.root]
    while pending and not stopped():
        total_here, subdirs = scan_dir(walk, pending.pop(), stopped)
        total += total_here
        pending.extend(subdirs)
    return total


class Measurer:
    """Measures directories in parallel, publishing totals as they climb.

    Subclasses supply the measuring; this supplies the driving. Work sits in a
    deque, whose append and popleft are atomic under the GIL and so need no lock
    of its own -- an earlier version guarded it with a condition variable, and on
    a disk made of thousands of small directories the contention cost more than
    the work it coordinated.
    """

    # A walk of an outer directory already reads every directory inside it. An
    # engine that can pick the inner totals out of that one pass says so here,
    # and is handed only the outermost paths.
    SHARES_WALKS = False

    def __init__(self, workers: int = 8, cancel: threading.Event | None = None) -> None:
        self.workers = max(1, workers)
        self.cancel = cancel or threading.Event()
        self.covered: dict[str, Walk] = {}   # inner path -> its Walk, filled by run()
        self._queue: deque = deque()
        self._stop = False

    # -- what a subclass provides -------------------------------------------- #

    def _seed(self, walk: Walk) -> bool:
        """Queue the initial work for one walk. False if it cannot be measured."""
        raise NotImplementedError

    def _step(self, item) -> None:
        """Do one unit of queued work, updating its walk."""
        raise NotImplementedError

    def _cleanup(self) -> None:
        """Release anything still running. Called once, on the way out."""

    # -- the driving ---------------------------------------------------------- #

    def _worker(self) -> None:
        idle = 0.0
        while not self._stop:
            try:
                item = self._queue.popleft()
            except IndexError:
                # briefly nothing to do: back off instead of spinning on the GIL
                idle = min(0.02, idle * 2 + 0.0002)
                time.sleep(idle)
                continue
            idle = 0.0
            try:
                self._step(item)
            except Exception:
                pass

    def stop(self) -> None:
        self._stop = True
        self._queue.clear()
        self._cleanup()

    @staticmethod
    def outermost(paths: list[str]) -> tuple[list[str], dict[str, str]]:
        """Split paths into the ones to walk and the ones those walks contain.

        Sorted by component so a directory always precedes everything beneath
        it whatever its siblings are called -- the same reason Model.recompute
        sorts that way."""
        outer: list[str] = []
        covered: dict[str, str] = {}
        for path in sorted(set(paths), key=lambda p: p.split(os.sep)):
            enclosing = next((o for o in reversed(outer)
                              if path.startswith(o + os.sep)), None)
            if enclosing is None:
                outer.append(path)
            else:
                covered[path] = enclosing
        return outer, covered

    def run(self, paths: list[str], publish, budget: float = MEASURE_BUDGET) -> None:
        """Measure every path, calling `publish` with a list of
        (path, bytes, status) once per tick. Status is "running" while the
        number is still climbing, "done" when it is exact, and "partial" when
        the budget expired and it is only a floor."""
        if self.SHARES_WALKS:
            to_walk, inside = self.outermost(paths)
        else:
            to_walk, inside = list(dict.fromkeys(paths)), {}

        walks: dict[str, Walk] = {}
        settled: list[tuple[str, int, str]] = []
        for path in inside:
            # not walked on its own; its total is read out of the enclosing walk
            walk = Walk(path)
            walks[path] = walk
            self.covered[path] = walk
        for path in to_walk:
            walk = Walk(path)
            if self._seed(walk):
                walks[path] = walk
                continue
            # gone between the catalog being built and now: no bytes, no mystery
            settled.append((path, 0, "done"))
            for inner, enclosing in inside.items():
                if enclosing == path:
                    settled.append((inner, 0, "done"))
                    walks.pop(inner, None)
                    self.covered.pop(inner, None)
        if settled:
            publish(settled)
        if not walks:
            return

        for _ in range(self.workers):
            threading.Thread(target=self._worker, daemon=True,
                             name="andy-measure").start()

        deadline = time.time() + budget
        finished: set[str] = set()
        shown: dict[str, int] = {}
        try:
            while len(finished) < len(walks):
                # `_stop` is stop() called from elsewhere -- a rescan, a quit --
                # and the workers have already been told. Waiting out the budget
                # for walks that will never finish would be waiting for nothing.
                if self.cancel.is_set() or self._stop:
                    return
                expired = time.time() >= deadline
                updates = []
                for path, walk in walks.items():
                    if path in finished:
                        continue
                    total, complete = walk.state()
                    if complete:
                        finished.add(path)
                        updates.append((path, total, "done"))
                    elif expired:
                        finished.add(path)
                        updates.append((path, total, "partial"))
                    elif shown.get(path) != total:
                        shown[path] = total
                        updates.append((path, total, "running"))
                if updates:
                    publish(updates)
                if len(finished) < len(walks):
                    time.sleep(MEASURE_TICK)
        finally:
            self.stop()


class DuMeasurer(Measurer):
    """Measure with du(1), one process per path, reading its output as it goes.

    `du -kx` without `-s` prints a line for every directory it finishes, and it
    finishes a directory only after everything inside it -- so the lines arrive
    in post-order and a running total can be kept exactly: a directory's line
    already contains the children counted from earlier lines, so those are
    swapped out for it rather than added again. The figure after the last line
    is the same number `du -skx` would have printed, and the figures before it
    are honest floors.

    This is what andy measures with. du is C, it uses the bulk directory calls
    the platform provides, and a process per path is real parallelism rather
    than eight Python threads taking turns with the GIL: measured against the
    in-process Walker on the same disk, it is about twice as fast on large trees
    and never slower. `-x` keeps it on one filesystem, so a network mount is
    never reported as local disk.
    """

    SHARES_WALKS = True

    def __init__(self, workers: int = 8, cancel: threading.Event | None = None) -> None:
        super().__init__(workers, cancel)
        self._procs: set = set()
        self._procs_lock = threading.Lock()

    def _seed(self, walk: Walk) -> bool:
        if not os.path.isdir(walk.root):
            return False
        self._queue.append(walk)
        return True

    def _step(self, walk: Walk) -> None:
        inside = {path: inner for path, inner in self.covered.items()
                  if path.startswith(walk.root + os.sep)}
        proc = None
        mangled = False
        try:
            # Read bytes, not text. A path is not locale text: in a C locale
            # `text=True` decodes du's output as ASCII and the first non-ASCII
            # path raises, which the handler below would swallow into a silent
            # under-count. os.fsdecode uses the filesystem encoding with
            # surrogateescape, so even a path that is valid in no encoding
            # survives the round trip.
            proc = subprocess.Popen(["du", "-kx", walk.root], stdout=subprocess.PIPE,
                                    stderr=subprocess.DEVNULL)
            with self._procs_lock:
                self._procs.add(proc)
            child: dict[str, int] = {}
            prefix = walk.root + os.sep
            for line in proc.stdout:
                if self._stop:
                    break
                kb, _, raw = line.rstrip(b"\n").partition(b"\t")
                try:
                    size = int(kb) * 1024
                except ValueError:
                    continue            # a warning on stdout, or a stray line
                path = os.fsdecode(raw)
                if path != walk.root and not path.startswith(prefix):
                    # du -kx <root> only ever prints paths under <root>. Anything
                    # else is half of a path containing a newline, which this
                    # line-oriented format cannot represent. Counting the halves
                    # would inflate the total, so stop reading and walk it here.
                    mangled = True
                    break
                gain = size - child.pop(path, 0)
                parent = os.path.dirname(path)
                child[parent] = child.get(parent, 0) + size
                if gain:
                    with walk.lock:
                        walk.total += gain
                inner = inside.get(path)
                if inner is not None:
                    # its own line is its whole subtree, exactly what `du -skx`
                    # of it would have said, and it lands before the outer total
                    with inner.lock:
                        inner.total = size
                        inner.pending = 0
        except Exception:
            pass
        finally:
            if proc is not None:
                self._close(proc)
            if mangled and not self._stop:
                self._fall_back(walk, inside)
            with walk.lock:
                walk.pending = 0
            for inner in inside.values():
                with inner.lock:
                    inner.pending = 0       # never named by du: not on this volume

    def _fall_back(self, walk: Walk, inside: dict) -> None:
        """Measure in process, for a tree du cannot describe."""
        with walk.lock:
            walk.total = 0
            walk.seen.clear()
        total = walk_tree(walk, lambda: self._stop)
        with walk.lock:
            walk.total = total
        for inner in inside.values():
            inner_total = walk_tree(inner, lambda: self._stop)
            with inner.lock:
                inner.total = inner_total

    def _close(self, proc) -> None:
        with self._procs_lock:
            self._procs.discard(proc)
        try:
            if proc.stdout:
                proc.stdout.close()
        except Exception:
            pass
        if proc.poll() is None:
            # du blocked on the I/O of a running VM will not die politely, and
            # an orphan left reading that disk would outlive andy
            try:
                proc.kill()
            except Exception:
                pass
        try:
            proc.wait(timeout=0.1)
        except Exception:
            pass

    def _cleanup(self) -> None:
        with self._procs_lock:
            procs = list(self._procs)
        for proc in procs:
            self._close(proc)


class Walker(Measurer):
    """Measure in this process, without shelling out to du.

    Sizes are `st_blocks * 512`: blocks actually allocated, which is what `du -k`
    reports and what the volume gives back when you delete the thing. `st_size`
    would lie in both directions -- a sparse container disk claims far more than
    it occupies, a tree of small files occupies far more than it claims.

    Matching `du -skx` otherwise means: never leaving the filesystem the walk
    started on; counting a symlink's own blocks but never following it; and
    counting a file with several hard links once. Hard links are deduplicated
    per walk rather than across the whole scan, which is `du -sk a; du -sk b`
    rather than `du -skx a b` -- andy reports each location on its own terms,
    and a file linked into two of them belongs to both.

    Slower than DuMeasurer, because the GIL serialises the per-entry work that
    du does in C. Kept, and reachable with `--walk`, for the machine where
    spawning processes is unwelcome or du behaves unlike either of the two
    implementations this was tested against.
    """

    def _seed(self, walk: Walk) -> bool:
        try:
            st = os.lstat(walk.root)
        except OSError:
            return False
        walk.dev = st.st_dev
        walk.total = st.st_blocks * 512
        self._queue.append((walk, walk.root))
        return True

    def _scan(self, walk: Walk, path: str) -> tuple[int, list[str]]:
        return scan_dir(walk, path, lambda: self._stop)

    def _step(self, item) -> None:
        walk, path = item
        total, subdirs = self._scan(walk, path)
        if self._stop:
            return
        # the net count -- this directory finished, its children queued -- is
        # applied before the children become visible, so a walk is never seen as
        # settled while there is still work coming.
        with walk.lock:
            walk.total += total
            walk.pending += len(subdirs) - 1
        if subdirs:
            self._queue.extend((walk, sub) for sub in subdirs)


