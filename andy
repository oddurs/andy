class Scanner:
    def __init__(self, model: Model, roots: list[str], include_projects: bool = True,
                 use_cache: bool = True, workers: int = 8) -> None:
        self.m = model
        self.roots = roots
        self.include_projects = include_projects
        self.use_cache = use_cache
        self.workers = workers
        self.cancel = threading.Event()
        self._thread: threading.Thread | None = None

    def start(self) -> None:
        self._thread = threading.Thread(target=self._guarded, daemon=True)
        self._thread.start()

    def join(self, timeout: float | None = None) -> None:
        if self._thread:
            self._thread.join(timeout)

    def _guarded(self) -> None:
        try:
            self.run()
        except Exception as exc:                        # never take the UI down
            with self.m.lock:
                self.m.phase = f"scan error: {exc}"
                self.m.finished = True

    # ----------------------------------------------------------------------- #

    def run(self) -> None:
        m = self.m
        cached = load_cache() if self.use_cache else {}
        cached_sizes: dict = cached.get("sizes", {}) or {}

        # ---- phase 1: the fixed catalog
        tasks = self._build_catalog(cached_sizes)
        with m.lock:
            m.phase = "measuring caches"
            m.pending = len(tasks)
            m.recompute()
            m.generation += 1

        pool = ThreadPoolExecutor(max_workers=self.workers)
        try:
            discovery = None
            if self.include_projects and self.roots:
                discovery = pool.submit(find_artifacts, self.roots)
            docker = pool.submit(docker_breakdown)

            self._measure(pool, tasks)

            # ---- phase 2: live docker detail, if a daemon answered
            rows = []
            try:
                rows = docker.result(timeout=20)
            except Exception:
                rows = []
            if rows:
                with m.lock:
                    parent = m.category(CONTAINERS)
                    live = Node(
                        label="docker · live breakdown",
                        note="What the running daemon holds. These bytes sit inside the "
                             "VM disk above, so they are not added to the total.",
                        kind="docker", safety=REVIEW, informational=True,
                    )
                    for label, size, cmd, safety, note in rows:
                        live.children.append(Node(
                            label=label, measured=size, size=size, note=note,
                            cmd=cmd, safety=safety, kind="docker", informational=True))
                    parent.children.append(live)
                    m.recompute()
                    m.generation += 1

            # ---- phase 3: per-project artifacts
            found: list[tuple[str, str]] = []
            if discovery is not None:
                with m.lock:
                    m.phase = "finding project artifacts"
                try:
                    found = discovery.result(timeout=900)
                except Exception:
                    found = []
            elif self.include_projects and cached.get("found"):
                # roots were given but discovery did not run; fall back to cache
                found = [tuple(x) for x in cached["found"]]

            if found:
                tasks2 = self._build_projects(found, cached_sizes)
                with m.lock:
                    m.phase = f"measuring {len(tasks2)} project directories"
                    m.pending += len(tasks2)
                    m.recompute()
                    m.generation += 1
                self._measure(pool, tasks2)
        finally:
            pool.shutdown(wait=False)

        with m.lock:
            for n in m.walk():
                if not n.blocked:
                    n.stale = False
            m.recompute()
            m.finished = True
            m.elapsed = time.time() - m.started
            m.phase = "done"
            m.generation += 1
        save_cache(m, found)

    # ----------------------------------------------------------------------- #

    def _build_catalog(self, cached_sizes: dict) -> list[Node]:
        m = self.m
        tasks: list[Node] = []
        with m.lock:
            for spec in CATALOG:
                if not usable_dir(spec.path):
                    continue
                node = Node(label=spec.label, path=os.path.normpath(spec.path),
                            note=spec.note, cmd=spec.cmd, safety=spec.safety,
                            kind=spec.cat)
                if node.path in cached_sizes:
                    node.measured = cached_sizes[node.path]
                    node.stale = True
                m.category(spec.cat).children.append(node)
                tasks.append(node)

                if spec.expand:
                    for child_path in sorted(glob.glob(spec.expand)):
                        if not usable_dir(child_path):
                            continue
                        child = Node(
                            label=name_for(child_path, spec.namer),
                            path=os.path.normpath(child_path),
                            note=spec.note, cmd=spec.cmd, safety=spec.safety,
                            kind=spec.cat,
                        )
                        if child.path in cached_sizes:
                            child.measured = cached_sizes[child.path]
                            child.stale = True
                        node.children.append(child)
                        tasks.append(child)
        return tasks

    def _build_projects(self, found: list[tuple[str, str]], cached_sizes: dict) -> list[Node]:
        m = self.m
        tasks: list[Node] = []
        with m.lock:
            groups: dict[str, Node] = {}
            repos = m.category(REPOS)
            projects = m.category(PROJECTS)
            for path, kind in found:
                path = os.path.normpath(path)
                if kind == ".git":
                    node = Node(
                        label=project_label(path, self.roots),
                        path=path, kind="git",
                        note="Git object database. Repacking often halves it.",
                        cmd="git -C <repo> gc --aggressive --prune=now", safety=REVIEW,
                    )
                    repos.children.append(node)
                else:
                    group = groups.get(kind)
                    if group is None:
                        group = Node(label=kind, kind=kind,
                                     note=ARTIFACT_NOTES.get(kind, "Regenerated by your build."),
                                     cmd=ARTIFACT_CMDS.get(kind, ""), safety=REBUILD)
                        groups[kind] = group
                        projects.children.append(group)
                    node = Node(
                        label=project_label(path, self.roots), path=path, kind=kind,
                        note=group.note, cmd=group.cmd, safety=group.safety,
                    )
                    group.children.append(node)
                if path in cached_sizes:
                    node.measured = cached_sizes[path]
                    node.stale = True
                tasks.append(node)
        return tasks

    def _measure(self, pool: ThreadPoolExecutor, tasks: list[Node]) -> None:
        """du the given nodes in parallel batches, publishing results as they land."""
        m = self.m
        by_path: dict[str, list[Node]] = {}
        for n in tasks:
            by_path.setdefault(n.path, []).append(n)
        paths = list(by_path)
        # small batches keep the UI moving; large ones keep du efficient
        batch = max(8, min(96, len(paths) // (self.workers * 3) or 8))
        chunks = [paths[i:i + batch] for i in range(0, len(paths), batch)]
        cap = min(180.0, 20.0 + 3.0 * batch)
        futures = {pool.submit(du_batch, c, cap): c for c in chunks}
        stragglers: list[str] = []
        for fut in as_completed(futures):
            if self.cancel.is_set():
                return
            try:
                sizes = fut.result()
            except Exception:
                sizes = {}
            chunk = futures[fut]
            with m.lock:
                for path in chunk:
                    got = sizes.get(path)
                    if got is None:
                        stragglers.append(path)
                        continue
                    for node in by_path.get(path, ()):
                        node.measured = got
                        node.stale = False
                        node.blocked = False
                    m.done += 1
                m.recompute()

        # anything the batch could not finish gets one more try on its own, so a
        # single pathological directory does not cost its neighbours their sizes
        if stragglers and not self.cancel.is_set():
            with m.lock:
                m.phase = f"retrying {len(stragglers)} slow {'path' if len(stragglers) == 1 else 'paths'}"
            retries = {pool.submit(du_batch, [path], 25.0): path for path in stragglers}
            for fut in as_completed(retries):
                path = retries[fut]
                try:
                    sizes = fut.result()
                except Exception:
                    sizes = {}
                got = sizes.get(path)
                with m.lock:
                    for node in by_path.get(path, ()):
                        if got is None:
                            # keep a cached figure if we have one; flag it either way
                            node.blocked = True
                            node.stale = node.measured is not None
                        else:
                            node.measured = got
                            node.stale = False
                            node.blocked = False
                    m.done += 1
                    m.recompute()


ARTIFACT_NOTES = {
    "node_modules": "Dependency trees. `npm ci` / `pnpm i` puts them back.",
    "python venv": "Virtual environments; recreate from your lockfile.",
    "cargo/maven target": "Compiled Rust or JVM output. `cargo clean` removes it.",
    ".git": "Git object database.",
    "cocoapods": "Installed pods; `pod install` restores them.",
    "deriveddata": "Xcode build intermediates inside the project.",
    "terraform": "Provider plugins, re-downloaded by `terraform init`.",
}

ARTIFACT_CMDS = {
    "node_modules": "find <root> -name node_modules -maxdepth 4 -prune -exec rm -rf {} +",
    "cargo/maven target": "cargo clean   # run inside the project",
    "python venv": "rm -rf <project>/.venv   # then recreate from the lockfile",
    "gradle (project)": "./gradlew clean",
    "next.js": "rm -rf <project>/.next",
    "cocoapods": "rm -rf <project>/Pods   # then: pod install",
    "deriveddata": "rm -rf <project>/DerivedData",
}


def name_for(path: str, namer: str | None) -> str:
    base = os.path.basename(path.rstrip("/"))
    if namer == "simulator":
        try:
            with open(os.path.join(path, "device.plist"), "rb") as fh:
                d = plistlib.load(fh)
            name = d.get("name") or base
            runtime = (d.get("runtime") or "").split(".")[-1].replace("-", " ")
            return f"{name} · {runtime}".strip(" ·")
        except Exception:
            return base
    return base


def project_label(path: str, roots: list[str]) -> str:
    """`repo/sub/path :: kind` trimmed relative to its scan root."""
    for r in sorted(roots, key=len, reverse=True):
        if path.startswith(r + os.sep):
            rel = path[len(r) + 1:]
            break
    else:
        rel = tilde(path)
    parts = rel.split(os.sep)
    if len(parts) > 4:
        parts = parts[:2] + ["…"] + parts[-2:]
    return os.sep.join(parts)


