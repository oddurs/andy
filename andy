HOME = os.path.expanduser("~")


def xdg(var: str, default: str) -> str:
    """An XDG base directory, or its default under HOME.

    The spec says a relative value is invalid and must be ignored, which also
    catches the empty string a shell leaves behind when a variable is set but
    unset. andy honours these on macOS too: a tool that reads XDG_CACHE_HOME on
    Linux reads it on a Mac as well, and andy should look where the tool put
    things rather than where the platform suggests.
    """
    value = os.environ.get(var, "")
    return value.rstrip(os.sep) if value.startswith(os.sep) else os.path.join(HOME, default)


XDG_CACHE = xdg("XDG_CACHE_HOME", ".cache")
XDG_CONFIG = xdg("XDG_CONFIG_HOME", ".config")
XDG_DATA = xdg("XDG_DATA_HOME", os.path.join(".local", "share"))
XDG_STATE = xdg("XDG_STATE_HOME", os.path.join(".local", "state"))

# Longest first, so ~/.local/share wins over ~/.local.
XDG_PREFIXES = tuple(sorted(
    ((os.path.join(HOME, ".cache"), XDG_CACHE),
     (os.path.join(HOME, ".config"), XDG_CONFIG),
     (os.path.join(HOME, ".local", "share"), XDG_DATA),
     (os.path.join(HOME, ".local", "state"), XDG_STATE)),
    key=lambda pair: -len(pair[0])))


def xdg_path(path: str) -> str:
    """Rewrite a catalog path onto wherever XDG actually points.

    The catalog is written with ~/.cache/... literals because that is what the
    entries are called and what a reader recognises. This is the one place the
    variables are applied, so the catalog stays readable and the lookup stays
    correct.
    """
    for default, actual in XDG_PREFIXES:
        if default == actual:
            continue
        if path == default:
            return actual
        if path.startswith(default + os.sep):
            return actual + path[len(default):]
    return path


