class Scanner:
    def __init__(self, model: Model, roots: list[str], include_projects: bool = True,
                 use_cache: bool = True, workers: int = 8, use_walker: bool = False) -> None:
        self.m = model
        self.roots = roots
        self.include_projects = include_projects
        self.use_cache = use_cache
        self.workers = workers
        self.use_walker = use_walker
        self.cancel = threading.Event()
        self._thread: threading.Thread | None = None

    def start(self) -> None:
        self._thread = threading.Thread(target=self._guarded, daemon=True)
        self._thread.start()

    def join(self, timeout: float | None = None) -> None:
        if self._thread:
            self._thread.join(timeout)

    def _guarded(self) -> None:
        try:
            self.run()
        except Exception as exc:                        # never take the UI down
            with self.m.lock:
                self.m.phase = f"scan error: {exc}"
                self.m.finished = True

    # ----------------------------------------------------------------------- #

    def run(self) -> None:
        m = self.m
        cached = load_cache() if self.use_cache else {}
        cached_sizes: dict = cached.get("sizes", {}) or {}
        with m.lock:
            m.previous_at = float(cached.get("ts") or 0.0)

        # ---- phase 1: the fixed catalog
        tasks = self._build_catalog(cached_sizes)
        with m.lock:
            m.phase = "measuring caches"
            m.pending = len({n.path for n in tasks})
            m.recompute()
            m.generation += 1

        discovery = None
        if self.include_projects and self.roots:
            discovery = Task(find_artifacts, self.roots)
        docker = Task(docker_breakdown)

        self._measure(tasks)

        # ---- phase 2: live docker detail, if a daemon answered
        rows = docker.result(timeout=20, default=[])
        if rows:
            # On macOS the daemon lives in a VM whose disk andy already measured,
            # so these are the same bytes seen from inside and must not be added.
            # On Linux there is no VM: /var/lib/docker is the real thing, it needs
            # root to measure, and `docker system df` is the only figure available
            # without privileges -- so there it counts.
            duplicate = MACOS
            with m.lock:
                parent = m.category(CONTAINERS)
                live = Node(
                    label=f"docker {DOT} live breakdown" if duplicate else "docker",
                    note=("What the running daemon holds. These bytes sit inside the "
                          "VM disk above, so they are not added to the total."
                          if duplicate else
                          "What the daemon holds under /var/lib/docker, as it reports "
                          "it. andy cannot read that directory without root, so this "
                          "is the figure it uses."),
                    kind="docker", safety=REVIEW, informational=duplicate,
                )
                for label, size, cmd, safety, note in rows:
                    live.children.append(Node(
                        label=label, measured=size, size=size, note=note,
                        cmd=cmd, safety=safety, kind="docker",
                        informational=duplicate))
                parent.children.append(live)
                m.recompute()
                m.generation += 1

        # ---- phase 3: per-project artifacts
        found: list[tuple[str, str]] = []
        if discovery is not None:
            with m.lock:
                m.phase = "finding project artifacts"
            found = discovery.result(timeout=900, default=[])
        elif self.include_projects and cached.get("found"):
            # roots were given but discovery did not run; fall back to cache
            found = [tuple(x) for x in cached["found"]]

        if found:
            tasks2 = self._build_projects(found, cached_sizes)
            with m.lock:
                m.phase = f"measuring {len(tasks2)} project directories"
                m.pending += len({n.path for n in tasks2})
                m.recompute()
                m.generation += 1
            self._measure(tasks2)

        with m.lock:
            for n in m.walk():
                if not n.blocked:
                    n.stale = False
            # a location that was measured last time and is not here now is the
            # most interesting kind of change, and the only one the tree cannot
            # show, because there is no row left to put it on
            here = {n.path for n in m.walk() if n.path}
            m.vanished = sorted(((p, size) for p, size in cached_sizes.items()
                                 if p not in here and size),
                                key=lambda pair: -pair[1])
            m.recompute()
            m.finished = True
            m.elapsed = time.time() - m.started
            m.phase = "done"
            m.generation += 1
        save_cache(m, found)

    # ----------------------------------------------------------------------- #

    def _build_catalog(self, cached_sizes: dict) -> list[Node]:
        m = self.m
        tasks: list[Node] = []
        with m.lock:
            for spec in CATALOG:
                if not usable_dir(spec.path):
                    continue
                node = Node(label=spec.label, path=os.path.normpath(spec.path),
                            note=spec.note, cmd=spec.cmd, safety=spec.safety,
                            kind=spec.cat)
                if node.path in cached_sizes:
                    node.measured = cached_sizes[node.path]
                    node.before = cached_sizes[node.path]
                    node.stale = True
                m.category(spec.cat).children.append(node)
                tasks.append(node)

                if spec.expand:
                    for child_path in sorted(glob.glob(spec.expand)):
                        if not usable_dir(child_path):
                            continue
                        child = Node(
                            label=name_for(child_path, spec.namer),
                            path=os.path.normpath(child_path),
                            note=spec.note, cmd=spec.cmd, safety=spec.safety,
                            kind=spec.cat, detail=True,
                        )
                        if child.path in cached_sizes:
                            child.measured = cached_sizes[child.path]
                            child.before = cached_sizes[child.path]
                            child.stale = True
                        node.children.append(child)
                        tasks.append(child)
        return tasks

    def _build_projects(self, found: list[tuple[str, str]], cached_sizes: dict) -> list[Node]:
        m = self.m
        tasks: list[Node] = []
        with m.lock:
            groups: dict[str, Node] = {}
            repos = m.category(REPOS)
            projects = m.category(PROJECTS)
            for path, kind in found:
                path = os.path.normpath(path)
                if kind == ".git":
                    node = Node(
                        label=project_label(path, self.roots),
                        path=path, kind="git",
                        note="Git object database. Repacking often halves it.",
                        cmd="git -C <repo> gc --aggressive --prune=now", safety=REVIEW,
                    )
                    repos.children.append(node)
                else:
                    group = groups.get(kind)
                    if group is None:
                        group = Node(label=kind, kind=kind,
                                     note=ARTIFACT_NOTES.get(kind, "Regenerated by your build."),
                                     cmd=ARTIFACT_CMDS.get(kind, ""),
                                     safety=ARTIFACT_SAFETY.get(kind, REBUILD))
                        groups[kind] = group
                        projects.children.append(group)
                    node = Node(
                        label=project_label(path, self.roots), path=path, kind=kind,
                        note=group.note, cmd=group.cmd, safety=group.safety,
                    )
                    group.children.append(node)
                if path in cached_sizes:
                    node.measured = cached_sizes[path]
                    node.before = cached_sizes[path]
                    node.stale = True
                tasks.append(node)
        return tasks

    def _measure(self, tasks: list[Node]) -> None:
        """Measure the given nodes, publishing sizes as they climb."""
        m = self.m
        by_path: dict[str, list[Node]] = {}
        for n in tasks:
            by_path.setdefault(n.path, []).append(n)
        if not by_path:
            return

        def publish(updates: list[tuple[str, int, str]]) -> None:
            with m.lock:
                for path, size, status in updates:
                    for node in by_path.get(path, ()):
                        self._apply(node, size, status)
                    if status != "running":
                        m.done += 1
                m.recompute()

        engine = Walker if self.use_walker else DuMeasurer
        engine(self.workers, self.cancel).run(list(by_path), publish)

    @staticmethod
    def _apply(node: Node, size: int, status: str) -> None:
        """Fold one measurement into a node.

        A scan opens showing the previous run's figures, so a climbing partial
        must not be allowed to drag a cached 28G down to the 4K of the root
        directory and back up again. While a figure is still stale it is only
        replaced once the floor has overtaken it; after that every update is
        this scan's own and simply applies."""
        if status == "running":
            if not node.stale or size >= (node.measured or 0):
                node.measured = size
                node.stale = False
                node.partial = True
                node.blocked = False
        elif status == "done":
            node.measured = size
            node.stale = node.partial = node.blocked = False
        else:                       # the budget expired: what was counted is a floor
            node.blocked = True
            if size <= 0 and node.measured is None:
                node.partial = False    # nothing counted at all, so nothing to claim
            elif node.stale and (node.measured or 0) > size:
                node.partial = False    # last scan's complete figure is still plausible
            else:
                node.measured = size
                node.stale = False
                node.partial = True


