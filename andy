class Tui:
    MIN_SMALL = 10 * 2 ** 20     # hidden unless 'a'

    def __init__(self, stdscr, model: Model, scanner: Scanner,
                 use_mouse: bool = True) -> None:
        self.s = stdscr
        self.m = model
        self.scanner = scanner
        self.cursor = 0
        self.top = 0
        self.rows: list[tuple[Node, int, int]] = []
        self.restore: set[str] = set()
        self.filter = ""
        self.typing = False
        self.detail = True
        self.show_small = False
        self.sort_by_name = False
        self.help = False
        self.message = ""
        self.message_until = 0.0
        self.tick = 0
        self.use_mouse = use_mouse
        self.view = "tree"
        self.map_stack: list[Node] = []
        self.map_cells: list[tuple[Node, int, int, int, int]] = []
        self.map_sel = 0
        self.zones: list[tuple[int, int, int, str, object]] = []
        self.last_click = (0.0, -1)

    # -- curses plumbing ----------------------------------------------------- #

    # ncurses built with mouse version 1 has no BUTTON5, and misreports a
    # wheel-down as a position report. It only ever enables xterm mode 1000,
    # which never sends motion, so that bit is unambiguous here.
    WHEEL_DOWN = getattr(curses, "BUTTON5_PRESSED", curses.REPORT_MOUSE_POSITION)
    CLICK = (curses.BUTTON1_PRESSED | curses.BUTTON1_CLICKED)
    RIGHT_CLICK = (curses.BUTTON3_PRESSED | curses.BUTTON3_CLICKED)

    def setup(self) -> None:
        curses.curs_set(0)
        self.s.nodelay(True)
        self.s.keypad(True)
        if self.use_mouse:
            try:
                curses.mousemask(curses.ALL_MOUSE_EVENTS
                                 | curses.REPORT_MOUSE_POSITION)
                curses.mouseinterval(0)      # report presses at once, no lag
            except Exception:
                self.use_mouse = False
        self.colour = False
        try:
            curses.start_color()
            curses.use_default_colors()
            for i, fg in enumerate((curses.COLOR_CYAN, curses.COLOR_RED,
                                    curses.COLOR_YELLOW, curses.COLOR_GREEN), start=1):
                curses.init_pair(i, fg, -1)
            self.map_pairs = []
            if curses.COLORS >= 256:
                for k, (bg, fg) in enumerate(MAP_RAMP):
                    curses.init_pair(10 + k, fg, bg)
                    self.map_pairs.append(curses.color_pair(10 + k))
            self.colour = True
        except Exception:
            self.colour = False
            self.map_pairs = []
        self.ACCENT = curses.color_pair(1) if self.colour else curses.A_BOLD
        self.RED = curses.color_pair(2) if self.colour else curses.A_NORMAL
        self.YELLOW = curses.color_pair(3) if self.colour else curses.A_NORMAL
        self.GREEN = curses.color_pair(4) if self.colour else curses.A_NORMAL
        self.DIM = curses.A_DIM

    def put(self, y: int, x: int, text: str, attr: int = 0) -> None:
        h, w = self.s.getmaxyx()
        if y < 0 or y >= h or x >= w or not text:
            return
        try:
            self.s.addnstr(y, x, text, max(0, w - x - 1), attr)
        except curses.error:
            pass

    def zone(self, y: int, x0: int, x1: int, kind: str, payload=None) -> None:
        """Register a clickable span. Later registrations win, so narrow
        targets are added after the wide ones they sit on top of."""
        self.zones.append((y, x0, x1, kind, payload))

    def zone_at(self, y: int, x: int):
        for zy, x0, x1, kind, payload in reversed(self.zones):
            if zy == y and x0 <= x <= x1:
                return kind, payload
        return None, None

    def magnitude(self, n: int) -> int:
        if n >= 10 * 2 ** 30:
            return self.RED
        if n >= 2 ** 30:
            return self.YELLOW
        if n >= 100 * 2 ** 20:
            return curses.A_NORMAL
        return self.DIM

    def note(self, text: str, seconds: float = 2.0) -> None:
        self.message = text
        self.message_until = time.time() + seconds

    # -- the visible row list ------------------------------------------------ #

    def build_rows(self) -> None:
        filt = self.filter.lower()
        cache: dict[int, bool] = {}

        def hit(node: Node) -> bool:
            if not filt:
                return True
            key = id(node)
            if key in cache:
                return cache[key]
            own = filt in node.label.lower() or filt in tilde(node.path).lower()
            res = own or any(hit(c) for c in node.children)
            cache[key] = res
            return res

        def visible(node: Node) -> bool:
            if not hit(node):
                return False
            if node.size <= 0 and not node.children:
                return False
            return self.show_small or filt or node.size >= self.MIN_SMALL

        rows: list[tuple[Node, int, int]] = []

        def order(kids: list[Node]) -> list[Node]:
            if self.sort_by_name:
                return sorted(kids, key=lambda n: n.label.lower())
            return kids

        def emit(node: Node, depth: int, peak: int) -> None:
            rows.append((node, depth, peak))
            if node.children and (node.expanded or filt):
                inner_peak = max((c.size for c in node.children), default=1) or 1
                for child in order(node.children):
                    if visible(child):
                        emit(child, depth + 1, inner_peak)

        top_peak = max((c.size for c in self.m.categories), default=1) or 1
        for cat in order(self.m.categories):
            if cat.size <= 0 and not cat.children:
                continue
            if not hit(cat):
                continue
            emit(cat, 0, top_peak)
        self.rows = rows
        self.cursor = max(0, min(self.cursor, len(rows) - 1))

    # -- layout -------------------------------------------------------------- #

    def geometry(self):
        h, w = self.s.getmaxyx()
        head = 5
        foot = 1
        detail = 6 if self.detail and h >= 20 else 0
        body = max(1, h - head - foot - detail)
        return h, w, head, body, detail, foot

    def draw(self) -> None:
        self.s.erase()
        self.zones = []
        h, w, head, body, detail, foot = self.geometry()
        with self.m.lock:
            if self.restore:
                for n in self.m.walk():
                    if n.path in self.restore and n.children:
                        n.expanded = True
                if self.m.finished:
                    self.restore = set()
            self.build_rows()
            self.draw_header(w)
            if self.view == "map":
                self.draw_map(head, body, w)
            else:
                self.draw_body(head, body, w)
            if detail:
                self.draw_detail(head + body, detail, w)
        self.draw_footer(h - 1, w)
        if self.help:
            self.draw_help(h, w)
        self.s.noutrefresh()
        curses.doupdate()

    def draw_header(self, w: int) -> None:
        m = self.m
        total, used, free = m.disk
        pct = used / total if total else 0.0
        self.put(0, 0, " " * (w - 1))
        self.put(0, 1, "andy", curses.A_BOLD)
        if m.finished:
            right = f"{m.count} locations · {m.elapsed:.1f}s"
            attr = self.DIM
        else:
            right = (f"{SPINNER[self.tick % len(SPINNER)]} {m.phase} "
                     f"{m.done}/{max(m.pending, 1)}")
            attr = self.ACCENT
        self.put(0, max(11, w - len(right) - 2), right, attr)
        self.put(1, 1, "─" * max(0, w - 2), self.DIM)

        low = free < 15 * 2 ** 30
        self.put(2, 1, "volume", self.DIM)
        lead = f"{human(total)} · {human(used)} used · "
        free_text = f"{human(free)} free"
        self.put(2, 9, lead)
        x = 9 + len(lead)
        self.put(2, x, free_text, self.RED if low else self.GREEN)
        x += len(free_text) + 2
        # size the bar from what is actually left, so the percentage never clips
        pct_text = f"{pct * 100:.0f}%"
        bw = min(24, w - 2 - x - len(pct_text) - 1)
        if bw >= 6:
            self.put(2, x, bar(pct, bw), self.RED if low else self.ACCENT)
            self.put(2, x + bw + 1, pct_text, self.DIM)
        elif x + len(pct_text) < w - 1:
            self.put(2, x, pct_text, self.DIM)

        share = f"{m.total / used * 100:.0f}% of used space" if used else ""
        self.put(3, 1, "mapped", self.DIM)
        self.put(3, 9, human(m.total), curses.A_BOLD | self.magnitude(m.total))
        self.put(3, 9 + len(human(m.total)) + 2, share, self.DIM)
        if self.filter:
            tag = f"filter: {self.filter}" + ("█" if self.typing else "")
            self.put(3, max(40, w - len(tag) - 2), tag, self.ACCENT)
        self.put(4, 1, "─" * max(0, w - 2), self.DIM)

    def draw_body(self, y0: int, body: int, w: int) -> None:
        if not self.rows:
            self.put(y0 + 1, 3, "no matches" if self.filter else "scanning…", self.DIM)
            return
        if self.cursor < self.top:
            self.top = self.cursor
        if self.cursor >= self.top + body:
            self.top = self.cursor - body + 1
        self.top = max(0, min(self.top, max(0, len(self.rows) - body)))

        bw = max(8, min(22, w // 5))
        sizew = 6
        namespace = w - 3 - sizew - bw - 2
        pathw = 0
        if namespace > 54:
            pathw = min(38, namespace // 3)
        labelw = namespace - pathw - (2 if pathw else 0)

        for i in range(body):
            idx = self.top + i
            if idx >= len(self.rows):
                break
            node, depth, peak = self.rows[idx]
            y = y0 + i
            selected = idx == self.cursor
            indent = "  " * depth
            if node.children:
                glyph = "▾ " if (node.expanded or self.filter) else "▸ "
            else:
                glyph = "  "
            label = node.label if depth else node.label.upper()
            text = shorten(indent + glyph + label, labelw)

            self.zone(y, 0, w - 1, "row", idx)
            if node.children:
                gx = 1 + len(indent)
                self.zone(y, gx, gx + 1, "toggle", idx)

            frac = node.size / peak if peak else 0.0

            if selected:
                self.put(y, 0, " " * (w - 1), curses.A_REVERSE)
                self.put(y, 1, text, curses.A_REVERSE)
                if pathw and node.path:
                    self.put(y, 1 + labelw + 2, shorten(tilde(node.path), pathw),
                             curses.A_REVERSE)
                self.put(y, w - sizew - bw - 2, human(node.size, pad=True), curses.A_REVERSE)
                self.put(y, w - bw - 1, bar(frac, bw), curses.A_REVERSE)
                continue

            attr = curses.A_BOLD if depth == 0 else curses.A_NORMAL
            if node.stale:
                attr |= self.DIM
            self.put(y, 1, text, attr)
            if pathw and node.path:
                self.put(y, 1 + labelw + 2, shorten(tilde(node.path), pathw), self.DIM)
            size_text = "    ?" if (node.blocked and node.measured is None) \
                else human(node.size, pad=True)
            self.put(y, w - sizew - bw - 2, size_text,
                     self.RED if node.blocked else self.magnitude(node.size))
            self.put(y, w - bw - 1, bar(frac, bw),
                     self.ACCENT if depth == 0 else self.DIM)

        self.draw_scrollbar(y0, body, w)

    def draw_map(self, y0: int, body: int, w: int) -> None:
        level = self.map_level()
        self.put(y0, 0, " " * (w - 1))
        trail = " › ".join(n.label for n in self.map_stack) or "all categories"
        total = sum(n.size for n in level if not n.informational)
        head = f"{trail}" + ("   ← back" if self.map_stack else "")
        self.put(y0, 1, shorten(head, w - 16), curses.A_BOLD)
        shown = len([n for n in level if n.size > 0 and not n.informational])
        right = f"{human(total)} in {shown}"
        self.put(y0, max(20, w - len(right) - 2), right, self.DIM)
        if self.map_stack:
            self.zone(y0, 1, w - 2, "mapup")

        area_h = body - 2
        if area_h < 2 or w < 20:
            self.put(y0 + 2, 1, "not enough room for the map", self.DIM)
            self.map_cells = []
            return

        self.map_cells, skipped = map_cells(level, 1, y0 + 2, w - 2, area_h)
        if skipped:
            small = sum(n.size for n in skipped)
            tag = f"+{len(skipped)} too small to draw · {human(small)}"
            self.put(y0 + 1, 1, tag, self.DIM)
        if not self.map_cells:
            self.put(y0 + 2, 1, "nothing measured yet…", self.DIM)
            return
        self.map_sel = max(0, min(self.map_sel, len(self.map_cells) - 1))

        biggest = max(n.size for n, *_ in self.map_cells) or 1
        for i, (node, cx, cy, cw, ch) in enumerate(self.map_cells):
            # a square-root transfer spreads the mid tones on very skewed data
            # while staying monotone in size, so the ramp still reads as magnitude
            t = (node.size / biggest) ** 0.5
            step = min(len(MAP_RAMP) - 1, max(0, round((1 - t) * (len(MAP_RAMP) - 1))))
            fill = self.map_pairs[step] if self.map_pairs else curses.A_REVERSE
            if i == self.map_sel:
                fill |= curses.A_REVERSE
            dw, dh = max(1, cw - 1), max(1, ch - 1)
            for r in range(dh):
                self.put(cy + r, cx, " " * dw, fill)
                self.zone(cy + r, cx, cx + dw - 1, "cell", i)
            if dw >= 4:
                self.put(cy, cx, clip_end(node.label, dw), fill | curses.A_BOLD)
            if dh >= 2 and dw >= 5:
                self.put(cy + 1, cx, clip_end(human(node.size), dw), fill)
            if dh >= 4 and dw >= 12 and total:
                self.put(cy + 2, cx, f"{node.size / total * 100:.0f}%", fill)

    def draw_scrollbar(self, y0: int, body: int, w: int) -> None:
        total = len(self.rows)
        if total <= body:
            return
        limit = max(1, total - body)
        height = max(1, round(body * body / total))
        top = round(self.top / limit * (body - height))
        for i in range(body):
            self.zone(y0 + i, 0, 0, "scroll", i)
            if top <= i < top + height:
                self.put(y0 + i, 0, "▌", self.ACCENT)

    def parent_of(self, target: Node) -> Node | None:
        stack = list(self.m.categories)
        while stack:
            n = stack.pop()
            for c in n.children:
                if c is target:
                    return n
                stack.append(c)
        return None

    def draw_detail(self, y0: int, height: int, w: int) -> None:
        self.put(y0, 1, "─" * max(0, w - 2), self.DIM)
        node = self.focus()
        if node is None:
            return
        size = human(node.size)
        self.put(y0 + 1, 1, shorten(node.label, w - len(size) - 6), curses.A_BOLD)
        self.put(y0 + 1, w - len(size) - 2, size, curses.A_BOLD | self.magnitude(node.size))

        if node.path:
            self.put(y0 + 2, 1, shorten(node.path, w - 3), self.DIM)
            self.zone(y0 + 2, 1, w - 2, "copypath")
        elif node.children:
            biggest = max(node.children, key=lambda c: c.size)
            leaves = sum(1 for n in self.m.walk([node])
                         if n.measured is not None and not n.informational)
            summary = (f"{leaves} location{'s' if leaves != 1 else ''} · "
                       f"largest is {biggest.label} at {human(biggest.size)}")
            self.put(y0 + 2, 1, shorten(summary, w - 3), self.DIM)

        note = node.note
        if node.blocked:
            note = ("not measured — " + BLOCKED_HINT
                    + (" Showing the previous scan's figure." if node.measured else ""))
        if note:
            self.put(y0 + 3, 1, shorten(note, w - 3),
                     self.RED if node.blocked else 0)
        if node.cmd:
            self.put(y0 + 4, 1, "reclaim", self.DIM)
            self.put(y0 + 4, 9, shorten(node.cmd, w - 12), self.ACCENT)
            self.zone(y0 + 4, 1, w - 2, "copycmd")
        elif node.path:
            self.put(y0 + 4, 1, "reclaim", self.DIM)
            self.put(y0 + 4, 9, "no single command — inspect it first", self.DIM)

        if height >= 6:
            # a grouping row is not a thing you can delete, so it gets no rating
            if node.cmd or node.path:
                col = {SAFE: self.GREEN, REBUILD: self.YELLOW,
                       REVIEW: self.RED}.get(node.safety, self.DIM)
                self.put(y0 + 5, 1, "safety", self.DIM)
                self.put(y0 + 5, 9, SAFETY_TEXT.get(node.safety, node.safety), col)
            if node.informational:
                self.put(y0 + 5, 1, "counted", self.DIM)
                self.put(y0 + 5, 9, "inside the entry above, not added to the total",
                         self.DIM)
            hint = "c copy command · y copy path"
            if w > 78:
                self.put(y0 + 5, w - len(hint) - 2, hint, self.DIM)

    def draw_footer(self, y: int, w: int) -> None:
        self.put(y, 0, " " * (w - 1))
        if time.time() < self.message_until:
            self.put(y, 1, self.message, self.ACCENT | curses.A_BOLD)
            return
        if self.typing:
            self.put(y, 1, f"/{self.filter}█   "
                           f"↵ keep · esc clear", self.ACCENT)
            return
        # every segment is a click target as well as a key hint
        if self.view == "map":
            items = [("j/k", "move", None), ("↵", "open", None),
                     ("←", "back", "mapup"), ("m", "list", "map"),
                     ("d", "detail", "detail"), ("r", "rescan", "rescan"),
                     ("?", "keys", "help"), ("q", "quit", "quit")]
        else:
            items = [("j/k", "move", None), ("↵", "open", None),
                     ("e/E", "expand", "expand"), ("/", "filter", "filter"),
                     ("s", "sort", "sort"), ("m", "map", "map"),
                     ("d", "detail", "detail"), ("r", "rescan", "rescan"),
                     ("?", "keys", "help"), ("q", "quit", "quit")]
        while items:
            widths = [len(k) + 1 + len(lbl) for k, lbl, _ in items]
            if 1 + sum(widths) + 3 * (len(items) - 1) <= w - 2:
                break
            items.pop(0) if len(items) > 6 else items.pop(4)
        x = 1
        for key, label, kind in items:
            span = len(key) + 1 + len(label)
            self.put(y, x, key, self.ACCENT if kind else self.DIM)
            self.put(y, x + len(key) + 1, label, self.DIM)
            if kind:
                self.zone(y, x, x + span - 1, kind)
            x += span + 3

    def draw_help(self, h: int, w: int) -> None:
        """Two columns when there is room, so nothing gets truncated away."""
        blocks: list[list[tuple[str, str]]] = []
        for title, keys in HELP:
            blocks.append([(title, "")] + list(keys))

        keyw = max(len(k) for b in blocks for k, _ in b) + 1
        descw = max(len(d) for b in blocks for _, d in b) + 1
        colw = keyw + 2 + descw
        two = w >= colw * 2 + 10

        def flatten(bs):
            out: list[tuple[str, str]] = []
            for b in bs:
                out.extend(b)
                out.append(("", ""))
            return out[:-1] if out else out

        if two:
            counts = [len(b) + 1 for b in blocks]
            half, run, split = sum(counts) / 2, 0, len(blocks)
            for i, c in enumerate(counts):
                if run + c > half and i:
                    split = i
                    break
                run += c
            left, right = flatten(blocks[:split]), flatten(blocks[split:])
        else:
            left, right = flatten(blocks), []

        rows = max(len(left), len(right))
        bw = min(w - 4, colw * (2 if two else 1) + (8 if two else 6))
        bh = min(h - 2, rows + 4)
        y0, x0 = (h - bh) // 2, (w - bw) // 2
        for i in range(bh):
            self.put(y0 + i, x0, " " * bw, curses.A_REVERSE)
        self.put(y0 + 1, x0 + 2, "andy — keys", curses.A_REVERSE | curses.A_BOLD)

        def column(lines, cx, room):
            for i, (key, desc) in enumerate(lines[:room]):
                y = y0 + 3 + i
                if not desc:
                    self.put(y, cx, key, curses.A_REVERSE | curses.A_BOLD)
                else:
                    self.put(y, cx + 1, key.ljust(keyw), curses.A_REVERSE)
                    self.put(y, cx + 1 + keyw + 1, desc, curses.A_REVERSE)

        room = bh - 4
        column(left, x0 + 2, room)
        if right:
            column(right, x0 + 4 + colw, room)
        tail = "any key to close"
        self.put(y0 + bh - 1, x0 + bw - len(tail) - 2, tail, curses.A_REVERSE)

    # -- input --------------------------------------------------------------- #

    def current(self) -> Node | None:
        return self.rows[self.cursor][0] if self.rows else None

    def focus(self) -> Node | None:
        """The node the detail pane and the copy actions act on."""
        if self.view == "map":
            if 0 <= self.map_sel < len(self.map_cells):
                return self.map_cells[self.map_sel][0]
            return None
        return self.current()

    def map_level(self) -> list[Node]:
        return self.map_stack[-1].children if self.map_stack else self.m.categories

    def move(self, delta: int) -> None:
        if self.rows:
            self.cursor = max(0, min(len(self.rows) - 1, self.cursor + delta))

    def scroll(self, delta: int) -> None:
        """Move the viewport and carry the cursor along with it."""
        _, _, _, body, _, _ = self.geometry()
        limit = max(0, len(self.rows) - body)
        self.top = max(0, min(limit, self.top + delta))
        if self.rows:
            self.cursor = max(self.top, min(self.top + body - 1,
                                            min(self.cursor, len(self.rows) - 1)))

    def toggle(self, idx: int) -> None:
        if 0 <= idx < len(self.rows):
            node = self.rows[idx][0]
            if node.children:
                node.expanded = not node.expanded

    def reveal(self, node: Node) -> None:
        if not node.path:
            self.note("no path for this item")
            return
        try:
            subprocess.Popen(["open", "-R", node.path],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            self.note("revealed in Finder")
        except Exception:
            self.note("could not open Finder")

    def copy_cmd(self, node: Node) -> None:
        if node.cmd:
            self.note("copied command" if clip(node.cmd) else "could not copy")
        else:
            self.note("no command for this item")

    def mouse_event(self, mx: int, my: int, bstate: int) -> bool:
        if bstate & curses.BUTTON4_PRESSED:
            self.scroll(-3)
            return True
        if bstate & self.WHEEL_DOWN:
            self.scroll(3)
            return True

        kind, payload = self.zone_at(my, mx)
        if bstate & self.RIGHT_CLICK:
            if self.view == "map":
                self.map_up()
                return True
            if kind in ("row", "toggle"):
                self.cursor = payload
                self.copy_cmd(self.rows[payload][0])
            return True
        if not bstate & self.CLICK:
            return True

        self.typing = False
        now = time.time()
        if kind == "scroll":
            _, _, _, body, _, _ = self.geometry()
            span = max(1, body - 1)
            limit = max(0, len(self.rows) - body)
            self.top = max(0, min(limit, round(payload / span * limit)))
            self.cursor = max(self.top, min(self.top + body - 1, self.cursor))
            return True
        if kind == "mapup":
            self.map_up()
            return True
        if kind == "cell":
            was, when = self.last_click[1], self.last_click[0]
            self.map_sel = payload
            self.last_click = (now, 10_000 + payload)
            if was == 10_000 + payload and now - when < 0.45:
                self.map_drill()
            return True
        if kind == "map":
            self.view = "tree" if self.view == "map" else "map"
            self.map_stack, self.map_sel = [], 0
            return True
        if kind == "toggle":
            self.cursor = payload
            self.toggle(payload)
            return True
        if kind == "row":
            was, when = self.last_click[1], self.last_click[0]
            self.cursor = payload
            self.last_click = (now, payload)
            node = self.rows[payload][0]
            if was == payload and now - when < 0.45:      # double click
                if node.children:
                    self.toggle(payload)
                else:
                    self.reveal(node)
            return True
        if kind == "copycmd" and self.rows:
            self.copy_cmd(self.rows[self.cursor][0])
        elif kind == "copypath" and self.rows:
            node = self.rows[self.cursor][0]
            if node.path:
                self.note("copied path" if clip(node.path) else "could not copy")
        elif kind == "filter":
            self.typing = True
        elif kind == "sort":
            self.sort_by_name = not self.sort_by_name
            self.note("sorted by " + ("name" if self.sort_by_name else "size"))
        elif kind == "detail":
            self.detail = not self.detail
        elif kind == "expand":
            with self.m.lock:
                any_open = any(c.expanded for c in self.m.categories if c.children)
                self.set_expanded(self.m.categories, not any_open)
            if not self.rows:
                self.cursor = 0
        elif kind == "rescan":
            self.rescan()
        elif kind == "help":
            self.help = True
        elif kind == "quit":
            return False
        return True

    def set_expanded(self, nodes: list[Node], value: bool) -> None:
        for n in nodes:
            if n.children:
                n.expanded = value
                self.set_expanded(n.children, value)

    def handle(self, ch: int) -> bool:
        """Returns False to quit."""
        h, w, head, body, detail, foot = self.geometry()

        if ch == curses.KEY_MOUSE:
            try:
                _, mx, my, _, bstate = curses.getmouse()
            except curses.error:
                return True
            if self.help:
                self.help = False
                return True
            return self.mouse_event(mx, my, bstate)

        if self.help:
            self.help = False
            return True

        if self.typing:
            if ch in (10, 13, curses.KEY_ENTER):
                self.typing = False
            elif ch == 27:
                self.typing, self.filter = False, ""
            elif ch in (curses.KEY_BACKSPACE, 127, 8):
                self.filter = self.filter[:-1]
            elif 32 <= ch < 127:
                self.filter += chr(ch)
            return True

        if self.view == "map":
            return self.handle_map(ch)

        node = self.current()
        if ch in (ord("q"), 27):
            return False
        if ch in (ord("j"), curses.KEY_DOWN):
            self.move(1)
        elif ch in (ord("k"), curses.KEY_UP):
            self.move(-1)
        elif ch == 4:                                   # ctrl-d
            self.move(body // 2)
        elif ch == 21:                                  # ctrl-u
            self.move(-body // 2)
        elif ch == curses.KEY_NPAGE:
            self.move(body)
        elif ch == curses.KEY_PPAGE:
            self.move(-body)
        elif ch in (ord("g"), curses.KEY_HOME):
            self.cursor, self.top = 0, 0
        elif ch in (ord("G"), curses.KEY_END):
            self.cursor = max(0, len(self.rows) - 1)
        elif ch in (10, 13, curses.KEY_ENTER, ord(" "), 9, curses.KEY_RIGHT):
            if node and node.children:
                node.expanded = not node.expanded
        elif ch == curses.KEY_LEFT:
            if node and node.children and node.expanded:
                node.expanded = False
            elif node:
                with self.m.lock:
                    parent = self.parent_of(node)
                if parent:
                    for i, row in enumerate(self.rows):
                        if row[0] is parent:
                            self.cursor = i
                            break
        elif ch == ord("e"):
            with self.m.lock:
                self.set_expanded(self.m.categories, True)
        elif ch == ord("E"):
            with self.m.lock:
                self.set_expanded(self.m.categories, False)
            self.cursor = 0
        elif ch == ord("/"):
            self.typing = True
        elif ch == ord("s"):
            self.sort_by_name = not self.sort_by_name
            self.note("sorted by " + ("name" if self.sort_by_name else "size"))
        elif ch == ord("a"):
            self.show_small = not self.show_small
            self.note("showing everything" if self.show_small else "hiding items under 10M")
        elif ch == ord("d"):
            self.detail = not self.detail
        elif ch == ord("m"):
            self.view = "map"
            self.map_stack, self.map_sel = [], 0
        elif ch == ord("?"):
            self.help = True
        elif ch == ord("c") and node:
            self.copy_cmd(node)
        elif ch == ord("y") and node:
            if node.path:
                self.note("copied path" if clip(node.path) else "could not copy")
            else:
                self.note("no path for this item")
        elif ch == ord("o") and node:
            self.reveal(node)
        elif ch == ord("r"):
            self.rescan()
        elif ch == curses.KEY_RESIZE:
            pass
        return True

    def handle_map(self, ch: int) -> bool:
        node = self.focus()
        count = len(self.map_cells)
        if ch == ord("q"):
            return False
        if ch in (ord("m"), 27):
            self.view = "tree"
        elif ch in (ord("j"), curses.KEY_DOWN, curses.KEY_RIGHT, ord("l"), 9):
            if count:
                self.map_sel = (self.map_sel + 1) % count
        elif ch in (ord("k"), curses.KEY_UP, ord("h")):
            if count:
                self.map_sel = (self.map_sel - 1) % count
        elif ch in (10, 13, curses.KEY_ENTER, ord(" ")):
            self.map_drill()
        elif ch in (curses.KEY_LEFT, curses.KEY_BACKSPACE, 127, 8):
            self.map_up()
        elif ch == ord("d"):
            self.detail = not self.detail
        elif ch == ord("c") and node:
            self.copy_cmd(node)
        elif ch == ord("y") and node:
            if node.path:
                self.note("copied path" if clip(node.path) else "could not copy")
            else:
                self.note("no path for this item")
        elif ch == ord("o") and node:
            self.reveal(node)
        elif ch == ord("r"):
            self.rescan()
        elif ch == ord("?"):
            self.help = True
        return True

    def map_drill(self) -> None:
        node = self.focus()
        if node is None:
            return
        if node.kind == "fold":
            self.note("too small to open — press m for the list")
        elif node.children:
            self.map_stack.append(node)
            self.map_sel = 0
        else:
            self.note("nothing inside this one")

    def map_up(self) -> None:
        if self.map_stack:
            self.map_stack.pop()
            self.map_sel = 0
        else:
            self.note("already at the top")

    def rescan(self) -> None:
        if not self.m.finished:
            self.note("already scanning")
            return
        expanded = {n.path for n in self.m.walk() if n.expanded and n.path}
        with self.m.lock:
            self.m.categories = []
            self.m.total = self.m.done = self.m.pending = self.m.count = 0
            self.m.finished = False
            self.m.started = time.time()
            self.m.phase = "rescanning"
            self.m.disk = shutil.disk_usage(HOME)
        self.scanner = Scanner(self.m, self.m.roots,
                               include_projects=self.scanner.include_projects,
                               use_cache=False)
        self.scanner.start()
        self.restore = expanded
        self.note("rescanning")

    def loop(self) -> None:
        self.setup()
        while True:
            self.draw()
            self.tick += 1
            ch = -1
            deadline = time.time() + 0.12
            while time.time() < deadline:
                ch = self.s.getch()
                if ch != -1:
                    break
                time.sleep(0.01)
            if ch != -1 and not self.handle(ch):
                return


def run_tui(model: Model, scanner: Scanner, use_mouse: bool = True) -> None:
    def inner(stdscr):
        Tui(stdscr, model, scanner, use_mouse).loop()

    try:
        curses.wrapper(inner)
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print(file=sys.stderr)
        sys.exit(130)
