def name_for(path: str, namer: str | None) -> str:
    base = os.path.basename(path.rstrip("/"))
    if namer == "simulator":
        try:
            with open(os.path.join(path, "device.plist"), "rb") as fh:
                d = plistlib.load(fh)
            name = d.get("name") or base
            runtime = (d.get("runtime") or "").split(".")[-1].replace("-", " ")
            return f"{name} {DOT} {runtime}".strip(" " + DOT)
        except Exception:
            return base
    return base


def project_label(path: str, roots: list[str]) -> str:
    """`repo/sub/path :: kind` trimmed relative to its scan root."""
    for r in sorted(roots, key=len, reverse=True):
        if path.startswith(r + os.sep):
            rel = path[len(r) + 1:]
            break
    else:
        rel = tilde(path)
    # Deliberately not trimmed here. This is the label everything uses -- the
    # report, the browser, --json, --commands -- and how much of it fits is a
    # question about the column it lands in, not about the path. Trimming twice
    # is what produced `halide-theme...claude/.../print-sheet-ui/node_modules`.
    return rel


