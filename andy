def human(n: int, pad: bool = False) -> str:
    """Bytes as a short human string: 4.7G, 812M, 3.1K."""
    if n <= 0:
        return "    -" if pad else "-"
    for unit, step in (("T", 2 ** 40), ("G", 2 ** 30), ("M", 2 ** 20), ("K", 2 ** 10)):
        if n >= step:
            v = n / step
            s = f"{v:.0f}{unit}" if v >= 100 else f"{v:.1f}{unit}"
            break
    else:
        s = f"{n}B"
    return s.rjust(5) if pad else s


def tilde(path: str) -> str:
    if path == HOME:
        return "~"
    return "~" + path[len(HOME):] if path.startswith(HOME + os.sep) else path


def clip_end(text: str, width: int) -> str:
    """Trim from the right. For a narrow treemap cell the leading words are the
    identifying ones, so middle-elision would throw away the wrong half."""
    if width <= 0:
        return ""
    if len(text) <= width:
        return text
    return text[:width - 1] + "…" if width > 1 else text[:1]


def shorten(text: str, width: int) -> str:
    """Trim to width, eliding the middle of long paths."""
    if width <= 0:
        return ""
    if len(text) <= width:
        return text
    if width <= 3:
        return text[:width]
    keep = width - 1
    head = keep // 3
    return text[:head] + "…" + text[len(text) - (keep - head):]


BLOCKS = " ▏▎▍▌▋▊▉█"


def bar(fraction: float, width: int) -> str:
    """A horizontal bar with one-eighth-cell precision."""
    if width <= 0:
        return ""
    fraction = max(0.0, min(1.0, fraction))
    eighths = int(round(fraction * width * 8))
    full, rem = divmod(eighths, 8)
    full = min(full, width)
    out = "█" * full
    if rem and full < width:
        out += BLOCKS[rem]
    return out.ljust(width)


def clip(text: str) -> bool:
    """Put text on the clipboard. Read-only with respect to the filesystem."""
    try:
        p = subprocess.run(["pbcopy"], input=text, text=True, timeout=5)
        return p.returncode == 0
    except Exception:
        return False


def _parse_du(text: str) -> dict[str, int]:
    sizes: dict[str, int] = {}
    for line in text.splitlines():
        kb, _, path = line.partition("\t")
        try:
            sizes[path] = int(kb.strip()) * 1024
        except ValueError:
            continue
    return sizes


def du_batch(paths: list[str], timeout: float = 60.0) -> dict[str, int]:
    """Measure several paths with one du(1). Returns bytes keyed by path.

    `-x` keeps du on one filesystem, so it never wanders into a network share or
    a VM mount and reports space that is not on this disk. The timeout matters
    more than it looks: du on the data directory of a *running* container VM can
    block on I/O for many minutes at no CPU at all, and without a cap that single
    directory would stall the whole scan. du prints a line per path as it
    finishes, so whatever completed before the cap is still salvaged."""
    if not paths:
        return {}
    try:
        p = subprocess.run(["du", "-skx", *paths],
                           capture_output=True, text=True, timeout=timeout)
        return _parse_du(p.stdout)
    except subprocess.TimeoutExpired as exc:
        out = exc.stdout or ""
        if isinstance(out, bytes):
            out = out.decode("utf-8", "replace")
        return _parse_du(out)
    except Exception:
        return {}


def usable_dir(path: str) -> bool:
    return os.path.isdir(path) and not os.path.islink(path)


