# A sequential ramp of xterm-256 greys, darkest first, each paired with the label
# colour that gives it the better contrast (worst case 4.54:1, so every label
# clears AA). Area already carries magnitude here, so colour's job is only to
# separate neighbouring cells -- which greys do identically on a light or a dark
# terminal, since each cell supplies its own surface.
MAP_RAMP = ((239, 231), (241, 231), (243, 16), (245, 16), (247, 16), (249, 16))


def _worst_aspect(row: list[float], side: float) -> float:
    total = sum(row)
    if total <= 0 or side <= 0:
        return float("inf")
    s2, side2 = total * total, side * side
    return max(side2 * max(row) / s2, s2 / (side2 * min(row)))


def squarify(values: list[float], x: float, y: float, dx: float, dy: float):
    """Squarified treemap (Bruls, Huizing & van Wijk). `values` must be sorted
    descending and scaled so that their sum equals dx * dy. Returns one
    (x, y, w, h) per value, in the same order."""
    rects: list[tuple[float, float, float, float]] = []
    vals = list(values)
    while vals:
        if len(vals) == 1:
            rects.append((x, y, dx, dy))
            break
        side = min(dx, dy)
        if side <= 0:
            rects.extend((x, y, 0.0, 0.0) for _ in vals)
            break
        # grow a row for as long as its worst aspect ratio keeps improving
        row, i = [vals[0]], 1
        current = _worst_aspect(row, side)
        while i < len(vals):
            nxt = _worst_aspect(row + [vals[i]], side)
            if nxt > current:
                break
            row.append(vals[i])
            current = nxt
            i += 1
        total = sum(row)
        if dx >= dy:
            width = total / dy if dy else 0.0
            yy = y
            for v in row:
                height = dy * v / total if total else 0.0
                rects.append((x, yy, width, height))
                yy += height
            x += width
            dx -= width
        else:
            height = total / dx if dx else 0.0
            xx = x
            for v in row:
                width = dx * v / total if total else 0.0
                rects.append((xx, y, width, height))
                xx += width
            y += height
            dy -= height
        vals = vals[i:]
    return rects


def map_cells(nodes: list[Node], x0: int, y0: int, width: int, height: int):
    """Lay real nodes out over a character grid, largest first.

    Returns (cells, skipped). A category only earns a cell if that cell comes out
    big enough to label; the ones too small at this size are reported separately
    rather than folded together, so a large category never disappears just
    because a tiny one could not fit."""
    area = width * height
    live = [n for n in nodes if n.size > 0 and not n.informational]
    if not live or area <= 0:
        return [], []
    live.sort(key=lambda n: -n.size)

    def attempt(keep: list[Node]):
        total = sum(n.size for n in keep)
        if total <= 0:
            return []
        scaled = [n.size / total * area for n in keep]
        out = []
        for node, (rx, ry, rw, rh) in zip(
                keep, squarify(scaled, 0.0, 0.0, float(width), float(height))):
            ix, iy = int(round(rx)), int(round(ry))
            iw = max(0, int(round(rx + rw)) - ix)
            ih = max(0, int(round(ry + rh)) - iy)
            out.append((node, x0 + ix, y0 + iy, iw, ih))
        return out

    for count in range(len(live), 0, -1):
        cells = attempt(live[:count])
        if not cells:
            continue
        if count == 1 or all(w >= 5 and h >= 2 for _, _, _, w, h in cells):
            return cells, live[count:]
    return [], live


