def load_cache() -> dict:
    try:
        with open(CACHE_FILE) as fh:
            data = json.load(fh)
        if isinstance(data, dict) and "sizes" in data:
            return data
    except Exception:
        pass
    return {}


def save_cache(model: Model, found: list[tuple[str, str]]) -> None:
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        sizes = {n.path: n.measured for n in model.walk()
                 if n.measured is not None and n.path}
        tmp = CACHE_FILE + ".tmp"
        with open(tmp, "w") as fh:
            json.dump({"ts": time.time(), "version": VERSION, "roots": model.roots,
                       "sizes": sizes, "found": found}, fh)
        os.replace(tmp, CACHE_FILE)
    except Exception:
        pass


